# Copiar este archivo como .env (en la raíz del proyecto) y completar los
# valores. El .env no se sube al repo: tiene la contraseña de la base.
#
# Sin DATABASE_URL, Django usa SQLite local (db.sqlite3).
# Con DATABASE_URL, usa PostgreSQL. La cadena de Neon se copia desde la
# consola de Neon (Connect → Connection string) y termina en ?sslmode=require.

DATABASE_URL=postgresql://usuario:contraseña@host.neon.tech/nombre_base?sslmode=require
