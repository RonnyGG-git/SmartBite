SECRET_KEY=generar-con-python-c-"import secrets;print(secrets.token_urlsafe(50))"
DEBUG=False
DOMAIN=smartbite.tudominio.com
ALLOWED_HOSTS=smartbite.tudominio.com
CSRF_TRUSTED_ORIGINS=https://smartbite.tudominio.com
DATABASE_URL=postgresql://usuario:clave@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require
WEB_CONCURRENCY=2
BREVO_API_KEY=
DEFAULT_FROM_EMAIL=Smart Bite <smartbitesoporte@gmail.com>

# --- Pagos / pasarela ---
# SIMULADA = flujo local sin dinero real (default). WOMPI = pasarela real (tarjeta).
PASARELA_PROVEEDOR=SIMULADA
# Secret local para firmar eventos de la pasarela simulada (solo demo).
SIMULADA_SECRET=secreto-local-solo-para-demo
# Wompi (Colombia). En sandbox usa llaves pub_test_* / secretos de test.
WOMPI_PUBLIC_KEY=
WOMPI_INTEGRITY_SECRET=
WOMPI_EVENTS_SECRET=
WOMPI_CHECKOUT_URL=https://checkout.wompi.co/p/
# URL pública donde el celular del cliente alcanza la app (ej. túnel ngrok) para el redirect-url del checkout.
CAJA_BASE_URL=
