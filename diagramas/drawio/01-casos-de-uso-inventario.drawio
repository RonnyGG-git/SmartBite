<mxfile host="drawio_lib"><diagram id="d1" name="Casos de uso - Inventario"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1560" pageHeight="1294" background="#ffffff" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="&lt;b&gt;Diagrama de casos de uso — Inventario (Smart Bite)&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:13px' color='#555555'&gt;Lo que la app Django (rama smartbite) permite hacer hoy en Inventario, según su código&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=13;fontSize=20;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1480" height="50" as="geometry"/></mxCell><mxCell id="c3" value="«subsystem»&lt;br&gt;&lt;b&gt;Inventario&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fillColor=none;strokeColor=#333333;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;fontSize=15;" vertex="1" parent="1"><mxGeometry x="270" y="100" width="920" height="954" as="geometry"/></mxCell><mxCell id="c4" value="Jefe de&lt;br&gt;Inventario" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontFamily=Helvetica;fontSize=13;fillColor=#ffffff;strokeColor=#333333;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="170" y="444" width="40" height="80" as="geometry"/></mxCell><mxCell id="c5" value="Administrador" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontFamily=Helvetica;fontSize=13;fillColor=#ffffff;strokeColor=#333333;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="60" y="884" width="40" height="80" as="geometry"/></mxCell><mxCell id="c6" value="Registrar producto" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Helvetica;fontSize=13;" vertex="1" parent="1"><mxGeometry x="330" y="160" width="260" height="62" as="geometry"/></mxCell><mxCell id="c7" value="Actualizar producto" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Helvetica;fontSize=13;" vertex="1" parent="1"><mxGeometry x="330" y="248" width="260" height="62" as="geometry"/></mxCell><mxCell id="c8" value="Consultar inventario" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Helvetica;fontSize=13;" vertex="1" parent="1"><mxGeometry x="330" y="336" width="260" height="62" as="geometry"/></mxCell><mxCell id="c9" value="Consultar movimientos&lt;br&gt;de inventario" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Helvetica;fontSize=13;" vertex="1" parent="1"><mxGeometry x="330" y="424" width="260" height="62" as="geometry"/></mxCell><mxCell id="c10" value="Registrar entrada&lt;br&gt;de inventario" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Helvetica;fontSize=13;" vertex="1" parent="1"><mxGeometry x="330" y="512" width="260" height="62" as="geometry"/></mxCell><mxCell id="c11" value="Registrar salida&lt;br&gt;de inventario" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Helvetica;fontSize=13;" vertex="1" parent="1"><mxGeometry x="330" y="600" width="260" height="62" as="geometry"/></mxCell><mxCell id="c12" value="Realizar ajuste&lt;br&gt;de inventario" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Helvetica;fontSize=13;" vertex="1" parent="1"><mxGeometry x="330" y="688" width="260" height="62" as="geometry"/></mxCell><mxCell id="c13" value="Registrar pérdida&lt;br&gt;de producto" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Helvetica;fontSize=13;" vertex="1" parent="1"><mxGeometry x="330" y="776" width="260" height="62" as="geometry"/></mxCell><mxCell id="c14" value="Controlar existencias" style="ellipse;whiteSpa