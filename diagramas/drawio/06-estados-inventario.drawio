<mxfile host="drawio_lib"><diagram id="d1" name="Estados - Inventario"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1140" background="#ffffff" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="&lt;b&gt;Diagrama de estados — Inventario (Smart Bite)&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:13px' color='#555555'&gt;Cómo cambian el insumo, un movimiento de tipo AJUSTE y la solicitud de reabastecimiento&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=13;fontSize=20;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1820" height="50" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;stm Insumo (item_inventario)&lt;/b&gt;" style="shape=umlFrame;whiteSpace=wrap;html=1;pointerEvents=0;width=231;height=26;fillColor=none;strokeColor=#666666;align=left;spacingLeft=6;fontFamily=Helvetica;fontSize=13;fontSize=12;" vertex="1" parent="1"><mxGeometry x="30" y="100" width="820" height="1000" as="geometry"/></mxCell><mxCell id="c4" value="" style="ellipse;html=1;fillColor=#333333;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="62" y="180" width="26" height="26" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;Activo&lt;/b&gt;&lt;hr size='1'&gt;&lt;font style='font-size:11px'&gt;generar_perdidas_vencimiento() [fecha_vencimiento &amp;lt; hoy y stock_actual &amp;gt; 0]&lt;br&gt;        / SALIDA automática por todo el stock, una vez por día (RF-26, RF-38)&lt;/font&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=10;spacingRight=10;spacingTop=4;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Helvetica;fontSize=13;fontSize=13;" vertex="1" parent="1"><mxGeometry x="150" y="150" width="670" height="370" as="geometry"/></mxCell><mxCell id="c6" value="" style="html=1;endArrow=open;endSize=10;strokeColor=#333333;fontFamily=Helvetica;fontSize=13;fontSize=12;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0;entryY=0.3;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="75" y="276"/></Array></mxGeometry></mxCell><mxCell id="c7" value="/ stock_actual := 0;&lt;br&gt;codigo_unico := generado&lt;br&gt;(RF-1)" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontSize=11;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="36" y="290" width="110" height="52" as="geometry"/></mxCell><mxCell id="c8" value="" style="ellipse;html=1;fillColor=#333333;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="180" y="330" width="26" height="26" as="geometry"/></mxCell><mxCell id="c9" value="" style="rhombus;html=1;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="250" y="328" width="30" height="30" as="geometry"/></mxCell><mxCell id="c10" value="" style="html=1;endArrow=open;endSize=10;strokeColor=#333333;fontFamily=Helvetica;fontSize=13;fontSize=12;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c8" target="c9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c11" value="&lt;b&gt;Stock suficiente&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;{stock_minimo es NULL o&lt;br&gt;stock_actual ≥ stock_minimo}&lt;/font&gt;" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;verticalAlign=top;spacingTop=4;spacingLeft=6;spacingRight=6;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Helvetica;fontSize=13;fontSize=12;" vertex="1" parent="1"><mxGeometry x="350" y="250" width="200" height="60" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;Bajo el mínimo&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;{stock_actual &amp;lt; stock_minimo}&lt;/font&gt;" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;verticalAlign=top;spacingTop=4;spacingLeft=6;spacingRight=6;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Helvetica;fontSize=13;fontSize=12;" vertex="1" parent="1"><mxGeometry x="350" y="420" width="200" height="60" as="geometry"/></mxCell><mxCell id="c13" value="" style="html=1;endArrow=open;endSize=10;strokeColor=#333333;fontFamily=Helvetica;fontSize=13;fontSize=12;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0;entryX=0;entryY=0.5;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="c9" target="c11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c14" value="[else]" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontSize=11;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="205" y="268" width="60" height="18" as="geometry"/></mxCell><mxCell id="c15" value="" style="html=1;endArrow=open;endSize=10;strokeColor=#333333;fontFamily=Helvetica;fontSize=13;fontSize=12;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0;entryY=0.5;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="c9" target="c12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c16" value="[stock_actual &amp;lt;&lt;br&gt;stock_minimo]" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontSize=11;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="160" y="400" width="100" height="34" as="geometry"/></mxCell><mxCell id="c17" value="" style="html=1;endArrow=open;endSize=10;strokeColor=#333333;fontFamily=Helvetica;fontSize=13;fontSize=12;labelBackgroundColor=#ffffff;exitX=0.8;exitY=1;entryX=0.8;entryY=0;" edge="1" parent="1" source="c11" target="c12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c18" value="movimiento [stock_nuevo &amp;lt; stock_minimo]&lt;br&gt;/ generar solicitud PENDIENTE&lt;br&gt;si no hay otra (RF-28, RF-29)" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontSize=11;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="520" y="350" width="280" height="50" as="geometry"/></mxCell><mxCell id="c19" value="" style="html=1;endArrow=open;endSize=10;strokeColor=#333333;fontFamily=Helvetica;fontSize=13;fontSize=12;labelBackgroundColor=#ffffff;exitX=0.2;exitY=0;entryX=0.2;entryY=1;" edge="1" parent="1" source="c12" target="c11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c20" value="movimiento&lt;br&gt;[stock_nuevo ≥&lt;br&gt;stock_minimo]" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontSize=11;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="290" y="340" width="100" height="50" as="geometry"/></mxCell><mxCell id="c21" value="&lt;b&gt;Inactivo&lt;/b&gt;&lt;hr size='1'&gt;&lt;div style='text-align:left'&gt;&lt;font style='font-size:11px'&gt;desactivar / error «ya está inactivo» (RF-7)&lt;/font&gt;&lt;/div&gt;" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;verticalAlign=top;spacingTop=4;spacingLeft=6;spacingRight=6;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontFamily=Helvetica;fontSize=13;fontSize=12;" vertex="1" parent="1"><mxGeometry x="230" y="690" width="420" height="74" as="geometry"/></mxCell><mxCell id="c22" value="" style="html=1;endArrow=open;endSize=10;strokeColor=#333333;fontFamily=Helvetica;fontSize=13;fontSize=12;labelBackgroundColor=#ffffff;exitX=0.25;exitY=1;entryX=0.25;entryY=0;" edge="1" parent="1" source="c5" target="c21"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c23" value="desactivar&lt;br&gt;[no está en una orden&lt;br&gt;de compra abierta (RF-6)]" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontSize=11;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="140" y="570" width="190" height="50" as="geometry"/></mxCell><mxCell id="c24" value="" style="html=1;endArrow=open;endSize=10;strokeColor=#333333;fontFamily=Helvetica;fontSize=13;fontSize=12;labelBackgroundColor=#ffffff;exitX=0.75;exitY=0;entryX=0.75;entryY=1;" edge="1" parent="1" source="c21" target="c5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c25" value="reactivar" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontSize=11;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="560" y="600" width="90" height="18" as="geometry"/></mxCell><mxCell id="c26" value="Inactivo: fuera del control de existencias y de vencimientos (RF-33, RF-34); no disponible para Menú (RF-35); se conserva con su historial (RF-5)." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=8;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Helvetica;fontSize=13;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="860" width="440" height="60" as="geometry"/></mxCell><mxCell id="c27" value="" style="endArrow=none;dashed=1;html=1;strokeColor=#999999;" edge="1" parent="1" source="c26" target="c21"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c28" value="RF-6 lo impone el script de Compras (tarea T16, pendiente): hoy la base solo rechaza desactivar un insumo que ya está inactivo." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=8;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Helvetica;fontSize=13;fontSize=11;" vertex="1" parent="1"><mxGeometry x="520" y="860" width="310" height="60" as="geometry"/></mxCell><mxCell id="c29" value="Las transiciones de Activo a Inactivo y de vuelta salen del borde del estado compuesto: valen en cualquiera de sus subestados. Al reactivar se entra de nuevo por la elección." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=8;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Helvetica;fontSize=13;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="940" width="770" height="44" as="geometry"/></mxCell><mxCell id="c30" value="&lt;b&gt;stm Movimiento de tipo AJUSTE (movimiento_inventario)&lt;/b&gt;" style="shape=umlFrame;whiteSpace=wrap;html=1;pointerEvents=0;width=416;height=26;fillColor=none;strokeColor=#666666;align=left;spacingLeft=6;fontFamily=Helvetica;fontSize=13;fontSize=12;" vertex="1" parent="1"><mxGeometry x="890" y="100" width="980" height="440" as="geometry"/></mxCell><mxCell id="c31" value="" style="ellipse;html=1;fillColor=#333333;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="920" y="300" width="26" height="26" as="geometry"/></mxCell><mxCell id="c32" value="" style="rhombus;html=1;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="1040" y="298" width="30" height="30" as="geometry"/></mxCell><mxCell id="c33" value="" style="html=1;endArrow=open;endSize=10;strokeColor=#333333;fontFamily=Helvetica;fontSize=13;fontSize=12;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c31" target="c32"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c34" value="/ stock_anterior :=&lt;br&gt;stock bloqueado" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontSize=11;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="900" y="330" width="140" height="34" as="geometry"/></mxCell><mxCell id="c35" value="&lt;b&gt;Pendiente de aprobación&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;{requiere_aprobacion = true y&lt;br&gt;stock_nuevo es NULL}&lt;/font&gt;&lt;hr size='1'&gt;&lt;div style='text-align:left'&gt;&lt;font style='font-size:11px'&gt;modificar o borrar / error (RF-18)&lt;/font&gt;&lt;/div&gt;" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;verticalAlign=top;spacingTop=4;spacingLeft=6;spacingRight=6;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Helvetica;fontSize=13;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1220" y="160" width="290" height="92" as="geometry"/></mxCell><mxCell id="c36" value="&lt;b&gt;Aplicado&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;{stock_nuevo = cantidad_objetivo}&lt;/font&gt;&lt;hr size='1'&gt;&lt;div style='text-align:left'&gt;&lt;font style='font-size:11px'&gt;aprobar / error: no hay nada pendiente (RF-17)&lt;br&gt;modificar o borrar / error (RF-18)&lt;/font&gt;&lt;/div&gt;" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;verticalAlign=top;spacingTop=4;spacingLeft=6;spacingRight=6;fillColor=#d5e8d4;strokeColor=#82b366;fontFamily=Helvetica;fontSize=13;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1220" y="390" width="290" height="92" as="geometry"/></mxCell><mxCell id="c37" value="" style="html=1;endArrow=open;endSize=10;strokeColor=#333333;fontFamily=Helvetica;fontSize=13;fontSize=12;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0;entryX=0;entryY=0.5;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="c32" target="c35"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c38" value="[|cantidad_objetivo − stock| &amp;gt; umbral]" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontSize=11;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="930" y="182" width="260" height="18" as="geometry"/></mxCell><mxCell id="c39" value="" style="html=1;endArrow=open;endSize=10;strokeColor=#333333;fontFamily=Helvetica;fontSize=13;fontSize=12;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0;entryY=0.5;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="c32" target="c36"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c40" value="[else] / stock_nuevo :=&lt;br&gt;cantidad_objetivo" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontSize=11;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="1060" y="440" width="160" height="34" as="geometry"/></mxCell><mxCell id="c41" value="" style="html=1;endArrow=open;endSize=10;strokeColor=#333333;fontFamily=Helvetica;fontSize=13;fontSize=12;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="c35" target="c36"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c42" value="aprobar(aprobado_por)&lt;br&gt;/ stock_anterior := stock del momento;&lt;br&gt;stock_nuevo := cantidad_objetivo;&lt;br&gt;aprobado_en := now() (RF-17)" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontSize=11;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="1375" y="268" width="260" height="66" as="geometry"/></mxCell><mxCell id="c43" value="umbral = app.umbral_ajuste_aprobacion; si no se configura, 20 unidades (valor a confirmar). No hay estado de rechazo: un ajuste que no se aprueba queda pendiente." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=8;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Helvetica;fontSize=13;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1550" y="390" width="300" height="92" as="geometry"/></mxCell><mxCell id="c44" value="&lt;b&gt;stm Solicitud de reabastecimiento (solicitud_reabastecimiento)&lt;/b&gt;" style="shape=umlFrame;whiteSpace=wrap;html=1;pointerEvents=0;width=482;height=26;fillColor=none;strokeColor=#666666;align=left;spacingLeft=6;fontFamily=Helvetica;fontSize=13;fontSize=12;" vertex="1" parent="1"><mxGeometry x="890" y="580" width="980" height="520" as="geometry"/></mxCell><mxCell id="c45" value="" style="ellipse;html=1;fillColor=#333333;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="920" y="780" width="26" height="26" as="geometry"/></mxCell><mxCell id="c46" value="&lt;b&gt;PENDIENTE&lt;/b&gt;&lt;hr size='1'&gt;&lt;div style='text-align:left'&gt;&lt;font style='font-size:11px'&gt;vincular a una orden de compra&lt;br&gt;        / se asocia la orden (Compras)&lt;br&gt;orden cancelada o rechazada&lt;br&gt;        / se desvincula y sigue PENDIENTE (RF-78)&lt;/font&gt;&lt;/div&gt;" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;verticalAlign=top;spacingTop=4;spacingLeft=6;spacingRight=6;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Helvetica;fontSize=13;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1090" y="710" width="330" height="166" as="geometry"/></mxCell><mxCell id="c47" value="" style="html=1;endArrow=open;endSize=10;strokeColor=#333333;fontFamily=Helvetica;fontSize=13;fontSize=12;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.38;" edge="1" parent="1" source="c45" target="c46"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c48" value="/ cantidad_sugerida :=&lt;br&gt;stock_minimo − stock_nuevo" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontSize=11;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="900" y="802" width="180" height="34" as="geometry"/></mxCell><mxCell id="c49" value="&lt;b&gt;ATENDIDA&lt;/b&gt;" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;verticalAlign=top;spacingTop=4;spacingLeft=6;spacingRight=6;fillColor=#d5e8d4;strokeColor=#82b366;fontFamily=Helvetica;fontSize=13;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1550" y="650" width="180" height="50" as="geometry"/></mxCell><mxCell id="c50" value="&lt;b&gt;CANCELADA&lt;/b&gt;" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;verticalAlign=top;spacingTop=4;spacingLeft=6;spacingRight=6;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontFamily=Helvetica;fontSize=13;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1550" y="910" width="180" height="50" as="geometry"/></mxCell><mxCell id="c51" value="" style="html=1;endArrow=open;endSize=10;strokeColor=#333333;fontFamily=Helvetica;fontSize=13;fontSize=12;labelBackgroundColor=#ffffff;exitX=1;exitY=0.15;entryX=0;entryY=0.5;" edge="1" parent="1" source="c46" target="c49"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c52" value="orden recibida o cerrada&lt;br&gt;con faltantes (Compras, RF-77)" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontSize=11;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="1310" y="616" width="200" height="34" as="geometry"/></mxCell><mxCell id="c53" value="" style="html=1;endArrow=open;endSize=10;strokeColor=#333333;fontFamily=Helvetica;fontSize=13;fontSize=12;labelBackgroundColor=#ffffff;exitX=1;exitY=0.85;entryX=0;entryY=0.5;" edge="1" parent="1" source="c46" target="c50"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c54" value="cancelar" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontSize=11;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="1470" y="920" width="70" height="18" as="geometry"/></mxCell><mxCell id="c55" value="" style="ellipse;html=1;shape=endState;fillColor=#333333;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="1790" y="660" width="30" height="30" as="geometry"/></mxCell><mxCell id="c56" value="" style="ellipse;html=1;shape=endState;fillColor=#333333;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="1790" y="920" width="30" height="30" as="geometry"/></mxCell><mxCell id="c57" value="" style="html=1;endArrow=open;endSize=10;strokeColor=#333333;fontFamily=Helvetica;fontSize=13;fontSize=12;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c49" target="c55"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c58" value="" style="html=1;endArrow=open;endSize=10;strokeColor=#333333;fontFamily=Helvetica;fontSize=13;fontSize=12;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c50" target="c56"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c59" value="Nace cuando un movimiento deja el stock bajo el mínimo y no hay otra solicitud PENDIENTE del insumo (RF-28, RF-29)." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=8;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Helvetica;fontSize=13;fontSize=11;" vertex="1" parent="1"><mxGeometry x="910" y="630" width="170" height="92" as="geometry"/></mxCell><mxCell id="c60" value="" style="endArrow=none;dashed=1;html=1;strokeColor=#999999;" edge="1" parent="1" source="c59" target="c45"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c61" value="El estado ENVIADA existe en la tabla, pero Compras no lo usa: la solicitud sigue PENDIENTE mientras dura la compra, y así el índice único (una sola PENDIENTE por insumo) evita duplicados. Después de ATENDIDA o CANCELADA, el próximo movimiento bajo el mínimo genera una solicitud nueva." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=8;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Helvetica;fontSize=13;fontSize=11;" vertex="1" parent="1"><mxGeometry x="910" y="1000" width="940" height="64" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>