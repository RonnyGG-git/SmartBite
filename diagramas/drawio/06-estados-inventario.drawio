<mxfile host="drawio_lib"><diagram id="d1" name="Estados - Inventario"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1520" pageHeight="740" background="#ffffff" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="&lt;b&gt;Diagrama de estados — Compra y nivel de stock de un ítem (Smart Bite)&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:13px' color='#555555'&gt;Los estados que maneja hoy la app Django (rama smartbite)&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=13;fontSize=20;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1440" height="50" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;stm Compra&lt;/b&gt;" style="shape=umlFrame;whiteSpace=wrap;html=1;pointerEvents=0;width=98;height=26;fillColor=none;strokeColor=#666666;align=left;spacingLeft=6;fontFamily=Helvetica;fontSize=13;fontSize=12;" vertex="1" parent="1"><mxGeometry x="30" y="100" width="690" height="600" as="geometry"/></mxCell><mxCell id="c4" value="" style="ellipse;html=1;fillColor=#333333;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="90" y="190" width="26" height="26" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;PENDIENTE&lt;/b&gt;" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;verticalAlign=top;spacingTop=4;spacingLeft=6;spacingRight=6;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Helvetica;fontSize=13;fontSize=12;" vertex="1" parent="1"><mxGeometry x="240" y="170" width="220" height="66" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;RECIBIDA&lt;/b&gt;&lt;hr size='1'&gt;&lt;div style='text-align:left'&gt;&lt;font style='font-size:11px'&gt;recibir / (no cambia nada)&lt;br&gt;anular / (no cambia nada)&lt;/font&gt;&lt;/div&gt;" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;verticalAlign=top;spacingTop=4;spacingLeft=6;spacingRight=6;fillColor=#d5e8d4;strokeColor=#82b366;fontFamily=Helvetica;fontSize=13;fontSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="470" width="290" height="96" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;ANULADA&lt;/b&gt;&lt;hr size='1'&gt;&lt;div style='text-align:left'&gt;&lt;font style='font-size:11px'&gt;recibir / (no cambia nada)&lt;br&gt;anular / (no cambia nada)&lt;/font&gt;&lt;/div&gt;" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;verticalAlign=top;spacingTop=4;spacingLeft=6;spacingRight=6;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontFamily=Helvetica;fontSize=13;fontSize=12;" vertex="1" parent="1"><mxGeometry x="400" y="470" width="290" height="96" as="geometry"/></mxCell><mxCell id="c8" value="" style="html=1;endArrow=open;endSize=10;strokeColor=#333333;fontFamily=Helvetica;fontSize=13;fontSize=12;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c9" value="/ guardar la compra y&lt;br&gt;sus detalles (compra_crear)" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontSize=11;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="70" y="230" width="170" height="36" as="geometry"/></mxCell><mxCell id="c10" value="" style="html=1;endArrow=open;endSize=10;strokeColor=#333333;fontFamily=Helvetica;fontSize=13;fontSize=12;labelBackgroundColor=#ffffff;exitX=0.3;exitY=1;entryX=0.6;entryY=0;" edge="1" parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c11" value="recibir / sumar cada cantidad al&lt;br&gt;stock de su ítem y crear una&lt;br&gt;ENTRADA por detalle" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontSize=11;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="330" width="230" height="52" as="geometry"/></mxCell><mxCell id="c12" value="" style="html=1;endArrow=open;endSize=10;strokeColor=#333333;fontFamily=Helvetica;fontSize=13;fontSize=12;labelBackgroundColor=#ffffff;exitX=0.7;exitY=1;entryX=0.4;entryY=0;" edge="1" parent="1" source="c5" target="c7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c13" value="anular / (el stock&lt;br&gt;no cambia)" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontSize=11;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="470" y="340" width="150" height="36" as="geometry"/></mxCell><mxCell id="c14" value="RECIBIDA y ANULADA no tienen salida: ninguna vista las cambia. Recibir o anular otra vez no hace nada (la vista solo actúa si la compra está PENDIENTE)." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=8;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Helvetica;fontSize=13;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="600" width="630" height="56" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;stm ItemInventario (nivel de stock)&lt;/b&gt;" style="shape=umlFrame;whiteSpace=wrap;html=1;pointerEvents=0;width=283;height=26;fillColor=none;strokeColor=#666666;align=left;spacingLeft=6;fontFamily=Helvetica;fontSize=13;fontSize=12;" vertex="1" parent="1"><mxGeometry x="750" y="100" width="740" height="600" as="geometry"/></mxCell><mxCell id="c16" value="" style="ellipse;html=1;fillColor=#333333;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="800" y="190" width="26" height="26" as="geometry"/></mxCell><mxCell id="c17" value="" style="rhombus;html=1;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="1080" y="188" width="30" height="30" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b&gt;Stock normal&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;{stock_actual &amp;gt; stock_minimo}&lt;/font&gt;" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;verticalAlign=top;spacingTop=4;spacingLeft=6;spacingRight=6;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Helvetica;fontSize=13;fontSize=12;" vertex="1" parent="1"><mxGeometry x="800" y="360" width="260" height="70" as="geometry"/></mxCell><mxCell id="c19" value="&lt;b&gt;Stock bajo&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;{stock_actual ≤ stock_minimo}&lt;/font&gt;" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;verticalAlign=top;spacingTop=4;spacingLeft=6;spacingRight=6;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Helvetica;fontSize=13;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1190" y="360" width="260" height="70" as="geometry"/></mxCell><mxCell id="c20" value="" style="html=1;endArrow=open;endSize=10;strokeColor=#333333;fontFamily=Helvetica;fontSize=13;fontSize=12;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c16" target="c17"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c21" value="/ crear el ítem con el stock_actual&lt;br&gt;y el stock_minimo del formulario" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontSize=11;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="830" y="140" width="240" height="36" as="geometry"/></mxCell><mxCell id="c22" value="[else]" style="html=1;endArrow=open;endSize=10;strokeColor=#333333;fontFamily=Helvetica;fontSize=13;fontSize=12;labelBackgroundColor=#ffffff;exitX=0;exitY=1;entryX=0.6;entryY=0;" edge="1" parent="1" source="c17" target="c18"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c23" value="[stock_actual ≤ stock_minimo]" style="html=1;endArrow=open;endSize=10;strokeColor=#333333;fontFamily=Helvetica;fontSize=13;fontSize=12;labelBackgroundColor=#ffffff;exitX=1;exitY=1;entryX=0.4;entryY=0;" edge="1" parent="1" source="c17" target="c19"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c24" value="" style="html=1;endArrow=open;endSize=10;strokeColor=#333333;fontFamily=Helvetica;fontSize=13;fontSize=12;labelBackgroundColor=#ffffff;exitX=1;exitY=0.3;entryX=0;entryY=0.3;" edge="1" parent="1" source="c18" target="c19"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c25" value="salida, editar&lt;br&gt;[stock_actual ≤ stock_minimo]" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontSize=11;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="1030" y="326" width="200" height="36" as="geometry"/></mxCell><mxCell id="c26" value="" style="html=1;endArrow=open;endSize=10;strokeColor=#333333;fontFamily=Helvetica;fontSize=13;fontSize=12;labelBackgroundColor=#ffffff;exitX=0;exitY=0.75;entryX=1;entryY=0.75;" edge="1" parent="1" source="c19" target="c18"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c27" value="entrada, recibir compra, editar&lt;br&gt;[stock_actual &amp;gt; stock_minimo]" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontSize=11;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="1030" y="432" width="200" height="36" as="geometry"/></mxCell><mxCell id="c28" value="Eventos: entrada y salida = formulario de ajuste (item_ajustar_stock); recibir compra = compra_recibir; editar = formulario del ítem (item_editar), que deja cambiar stock_actual y stock_minimo a mano.&lt;br&gt;El nivel no se guarda: es la propiedad stock_bajo, y el listado muestra «Stock bajo» o «Normal». No hay estado activo/inactivo: el modelo no tiene ese campo." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=8;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Helvetica;fontSize=13;fontSize=11;" vertex="1" parent="1"><mxGeometry x="780" y="560" width="690" height="90" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>