<mxfile host="Smart Bite" type="device"><diagram id="d1" name="Estados - Inventario"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1060" background="#ffffff" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="&lt;b&gt;Diagrama de estados — Inventario (Smart Bite)&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:13px' color='#555555'&gt;Cómo cambian el insumo, un movimiento de tipo AJUSTE y la solicitud de reabastecimiento&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=13;fontSize=20;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1720" height="50" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;stm  Insumo (item_inventario)&lt;/b&gt;" style="shape=umlFrame;whiteSpace=wrap;html=1;pointerEvents=0;width=230;height=26;fillColor=none;strokeColor=#666666;fontFamily=Helvetica;fontSize=13;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="740" height="700" as="geometry"/></mxCell><mxCell id="c4" value="" style="ellipse;html=1;fillColor=#333333;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="70" y="160" width="30" height="30" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;Activo&lt;/b&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Helvetica;fontSize=13;fontSize=13;" vertex="1" parent="1"><mxGeometry x="150" y="150" width="600" height="330" as="geometry"/></mxCell><mxCell id="c6" value="" style="ellipse;html=1;fillColor=#333333;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="170" y="262" width="30" height="30" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;Stock suficiente&lt;/b&gt;&lt;hr size='1'&gt;&lt;font style='font-size:11px'&gt;stock ≥ mínimo,&lt;br&gt;o sin mínimo configurado&lt;/font&gt;" style="rounded=1;arcSize=24;whiteSpace=wrap;html=1;verticalAlign=top;spacingTop=6;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Helvetica;fontSize=13;fontSize=12;" vertex="1" parent="1"><mxGeometry x="215" y="240" width="190" height="70" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;Bajo el mínimo&lt;/b&gt;&lt;hr size='1'&gt;&lt;font style='font-size:11px'&gt;stock &amp;lt; stock_minimo&lt;br&gt;(vista_control_existencias)&lt;/font&gt;" style="rounded=1;arcSize=24;whiteSpace=wrap;html=1;verticalAlign=top;spacingTop=6;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Helvetica;fontSize=13;fontSize=12;" vertex="1" parent="1"><mxGeometry x="540" y="240" width="190" height="70" as="geometry"/></mxCell><mxCell id="c9" value="" style="html=1;endArrow=open;endSize=10;strokeColor=#333333;fontFamily=Helvetica;fontSize=13;fontSize=12;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c6" target="c7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c10" value="" style="html=1;endArrow=open;endSize=10;strokeColor=#333333;fontFamily=Helvetica;fontSize=13;fontSize=12;labelBackgroundColor=#ffffff;exitX=1;exitY=0.25;entryX=0;entryY=0.25;" edge="1" parent="1" source="c7" target="c8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c11" value="movimiento [stock_nuevo &amp;lt; stock_minimo]&lt;br&gt;/ solicitud PENDIENTE si no hay otra (RF-28, RF-29)" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontSize=11;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="300" y="196" width="340" height="34" as="geometry"/></mxCell><mxCell id="c12" value="" style="html=1;endArrow=open;endSize=10;strokeColor=#333333;fontFamily=Helvetica;fontSize=13;fontSize=12;labelBackgroundColor=#ffffff;exitX=0;exitY=0.8;entryX=1;entryY=0.8;" edge="1" parent="1" source="c8" target="c7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c13" value="movimiento [stock_nuevo ≥ stock_minimo]" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontSize=11;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="330" y="318" width="280" height="18" as="geometry"/></mxCell><mxCell id="c14" value="do / control de vencimiento: si el insumo venció con stock, SALIDA automática por todo el stock (RF-26), una vez por día (RF-38)" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontSize=11;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="170" y="395" width="560" height="34" as="geometry"/></mxCell><mxCell id="c15" value="" style="html=1;endArrow=open;endSize=10;strokeColor=#333333;fontFamily=Helvetica;fontSize=13;fontSize=12;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0;entryY=0.15;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c16" value="registrar insumo&lt;br&gt;(stock 0, código&lt;br&gt;automático, RF-1)" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontSize=11;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="50" y="205" width="100" height="50" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;Inactivo&lt;/b&gt;&lt;hr size='1'&gt;&lt;font style='font-size:11px'&gt;fuera del control de existencias y de vencimientos (RF-33, RF-34);&lt;br&gt;no disponible para Menú (RF-35); se conserva con su historial (RF-5)&lt;/font&gt;" style="rounded=1;arcSize=24;whiteSpace=wrap;html=1;verticalAlign=top;spacingTop=6;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontFamily=Helvetica;fontSize=13;fontSize=12;" vertex="1" parent="1"><mxGeometry x="190" y="610" width="480" height="96" as="geometry"/></mxCell><mxCell id="c18" value="" style="html=1;endArrow=open;endSize=10;strokeColor=#333333;fontFamily=Helvetica;fontSize=13;fontSize=12;labelBackgroundColor=#ffffff;exitX=0.3;exitY=1;entryX=0.3;entryY=0;" edge="1" parent="1" source="c5" target="c17"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c19" value="desactivar&lt;br&gt;[no está en una orden de&lt;br&gt;compra abierta (RF-6)]" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontSize=11;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="140" y="500" width="170" height="50" as="geometry"/></mxCell><mxCell id="c20" value="" style="html=1;endArrow=open;endSize=10;strokeColor=#333333;fontFamily=Helvetica;fontSize=13;fontSize=12;labelBackgroundColor=#ffffff;exitX=0.72;exitY=0;entryX=0.72;entryY=1;" edge="1" parent="1" source="c17" target="c5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c21" value="reactivar" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontSize=11;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="580" y="530" width="90" height="18" as="geometry"/></mxCell><mxCell id="c22" value="desactivar otra vez → error «ya está inactivo» (RF-7)" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontSize=11;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="190" y="712" width="480" height="18" as="geometry"/></mxCell><mxCell id="c23" value="RF-6 lo impone el script de Compras (tarea T16, pendiente): hoy la base solo rechaza desactivar un insumo que ya está inactivo." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=8;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Helvetica;fontSize=13;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="740" width="700" height="44" as="geometry"/></mxCell><mxCell id="c24" value="&lt;b&gt;stm  Movimiento de tipo AJUSTE (movimiento_inventario)&lt;/b&gt;" style="shape=umlFrame;whiteSpace=wrap;html=1;pointerEvents=0;width=380;height=26;fillColor=none;strokeColor=#666666;fontFamily=Helvetica;fontSize=13;fontSize=12;" vertex="1" parent="1"><mxGeometry x="820" y="100" width="940" height="380" as="geometry"/></mxCell><mxCell id="c25" value="" style="ellipse;html=1;fillColor=#333333;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="850" y="275" width="30" height="30" as="geometry"/></mxCell><mxCell id="c26" value="" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontFamily=Helvetica;fontSize=13;fontSize=11;" vertex="1" parent="1"><mxGeometry x="960" y="270" width="40" height="40" as="geometry"/></mxCell><mxCell id="c27" value="" style="html=1;endArrow=open;endSize=10;strokeColor=#333333;fontFamily=Helvetica;fontSize=13;fontSize=12;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c25" target="c26"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c28" value="registrar AJUSTE&lt;br&gt;(cantidad_objetivo,&lt;br&gt;motivo — RF-15, RF-16)" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontSize=11;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="830" y="318" width="150" height="50" as="geometry"/></mxCell><mxCell id="c29" value="&lt;b&gt;Pendiente de aprobación&lt;/b&gt;&lt;hr size='1'&gt;&lt;font style='font-size:11px'&gt;requiere_aprobacion = true;&lt;br&gt;el stock no cambia&lt;/font&gt;" style="rounded=1;arcSize=24;whiteSpace=wrap;html=1;verticalAlign=top;spacingTop=6;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Helvetica;fontSize=13;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1110" y="150" width="250" height="76" as="geometry"/></mxCell><mxCell id="c30" value="&lt;b&gt;Aplicado&lt;/b&gt;&lt;hr size='1'&gt;&lt;font style='font-size:11px'&gt;stock_actual = cantidad_objetivo;&lt;br&gt;no se edita ni se borra (RF-18)&lt;/font&gt;" style="rounded=1;arcSize=24;whiteSpace=wrap;html=1;verticalAlign=top;spacingTop=6;fillColor=#d5e8d4;strokeColor=#82b366;fontFamily=Helvetica;fontSize=13;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1110" y="360" width="250" height="76" as="geometry"/></mxCell><mxCell id="c31" value="" style="html=1;endArrow=open;endSize=10;strokeColor=#333333;fontFamily=Helvetica;fontSize=13;fontSize=12;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0;entryX=0;entryY=0.5;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="c26" target="c29"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c32" value="[|objetivo − stock| &amp;gt; umbral]" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontSize=11;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="900" y="168" width="200" height="18" as="geometry"/></mxCell><mxCell id="c33" value="" style="html=1;endArrow=open;endSize=10;strokeColor=#333333;fontFamily=Helvetica;fontSize=13;fontSize=12;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0;entryY=0.5;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="c26" target="c30"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c34" value="[|objetivo − stock| ≤ umbral]" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontSize=11;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="875" y="412" width="210" height="18" as="geometry"/></mxCell><mxCell id="c35" value="" style="html=1;endArrow=open;endSize=10;strokeColor=#333333;fontFamily=Helvetica;fontSize=13;fontSize=12;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="c29" target="c30"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c36" value="aprobar (aprobado_por)&lt;br&gt;/ toma el stock del momento, stock_nuevo = objetivo,&lt;br&gt;aprobado_en = now() (RF-17)" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontSize=11;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="1245" y="262" width="330" height="50" as="geometry"/></mxCell><mxCell id="c37" value="aprobar otra vez → error (se aprueba una sola vez)" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontSize=11;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="1380" y="380" width="360" height="18" as="geometry"/></mxCell><mxCell id="c38" value="umbral: app.umbral_ajuste_aprobacion, 20 si no se configura" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontSize=11;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="1380" y="404" width="360" height="18" as="geometry"/></mxCell><mxCell id="c39" value="&lt;b&gt;stm  Solicitud de reabastecimiento&lt;/b&gt;" style="shape=umlFrame;whiteSpace=wrap;html=1;pointerEvents=0;width=260;height=26;fillColor=none;strokeColor=#666666;fontFamily=Helvetica;fontSize=13;fontSize=12;" vertex="1" parent="1"><mxGeometry x="820" y="510" width="940" height="500" as="geometry"/></mxCell><mxCell id="c40" value="" style="ellipse;html=1;fillColor=#333333;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="850" y="700" width="30" height="30" as="geometry"/></mxCell><mxCell id="c41" value="&lt;b&gt;PENDIENTE&lt;/b&gt;&lt;hr size='1'&gt;&lt;font style='font-size:11px'&gt;vincular a una orden de compra:&lt;br&gt;sigue PENDIENTE mientras dura la&lt;br&gt;compra; si la orden se cancela o se&lt;br&gt;rechaza, se desvincula (Compras,&lt;br&gt;RF-78)&lt;/font&gt;" style="rounded=1;arcSize=24;whiteSpace=wrap;html=1;verticalAlign=top;spacingTop=6;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Helvetica;fontSize=13;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1010" y="650" width="260" height="130" as="geometry"/></mxCell><mxCell id="c42" value="" style="html=1;endArrow=open;endSize=10;strokeColor=#333333;fontFamily=Helvetica;fontSize=13;fontSize=12;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c40" target="c41"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c43" value="stock bajo el mínimo&lt;br&gt;[no hay otra PENDIENTE&lt;br&gt;del insumo] (RF-28, RF-29)" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontSize=11;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="830" y="610" width="180" height="50" as="geometry"/></mxCell><mxCell id="c44" value="&lt;b&gt;ATENDIDA&lt;/b&gt;" style="rounded=1;arcSize=24;whiteSpace=wrap;html=1;verticalAlign=top;spacingTop=6;fillColor=#d5e8d4;strokeColor=#82b366;fontFamily=Helvetica;fontSize=13;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1450" y="580" width="180" height="56" as="geometry"/></mxCell><mxCell id="c45" value="&lt;b&gt;CANCELADA&lt;/b&gt;" style="rounded=1;arcSize=24;whiteSpace=wrap;html=1;verticalAlign=top;spacingTop=6;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontFamily=Helvetica;fontSize=13;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1450" y="800" width="180" height="56" as="geometry"/></mxCell><mxCell id="c46" value="" style="html=1;endArrow=open;endSize=10;strokeColor=#333333;fontFamily=Helvetica;fontSize=13;fontSize=12;labelBackgroundColor=#ffffff;exitX=1;exitY=0.25;entryX=0;entryY=0.5;" edge="1" parent="1" source="c41" target="c44"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c47" value="su orden queda recibida o&lt;br&gt;cerrada con faltantes&lt;br&gt;(Compras, RF-77)" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontSize=11;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="1235" y="548" width="190" height="50" as="geometry"/></mxCell><mxCell id="c48" value="" style="html=1;endArrow=open;endSize=10;strokeColor=#333333;fontFamily=Helvetica;fontSize=13;fontSize=12;labelBackgroundColor=#ffffff;exitX=1;exitY=0.8;entryX=0;entryY=0.5;" edge="1" parent="1" source="c41" target="c45"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c49" value="cancelar&lt;br&gt;(lo decide la aplicación)" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontSize=11;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="1285" y="800" width="160" height="36" as="geometry"/></mxCell><mxCell id="c50" value="" style="ellipse;html=1;shape=endState;fillColor=#333333;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="1680" y="592" width="32" height="32" as="geometry"/></mxCell><mxCell id="c51" value="" style="ellipse;html=1;shape=endState;fillColor=#333333;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="1680" y="812" width="32" height="32" as="geometry"/></mxCell><mxCell id="c52" value="" style="html=1;endArrow=open;endSize=10;strokeColor=#333333;fontFamily=Helvetica;fontSize=13;fontSize=12;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c44" target="c50"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c53" value="" style="html=1;endArrow=open;endSize=10;strokeColor=#333333;fontFamily=Helvetica;fontSize=13;fontSize=12;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c45" target="c51"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c54" value="El estado ENVIADA existe en la tabla, pero Compras no lo usa: la solicitud sigue PENDIENTE mientras dura la compra, y así el índice único (una sola PENDIENTE por insumo) evita solicitudes duplicadas. Después de ATENDIDA o CANCELADA, el próximo movimiento bajo el mínimo genera una solicitud nueva." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=8;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Helvetica;fontSize=13;fontSize=11;" vertex="1" parent="1"><mxGeometry x="850" y="930" width="880" height="60" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>