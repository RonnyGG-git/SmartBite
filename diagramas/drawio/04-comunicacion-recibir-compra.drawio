<mxfile host="drawio_lib"><diagram id="d1" name="Comunicación - Recibir compra"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1720" pageHeight="1265" background="#ffffff" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="&lt;b&gt;Diagrama de comunicación — Recibir una compra y registrar las entradas (CU-COM-13, CU-INV-05)&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:13px' color='#555555'&gt;Cómo lo hace la vista compra_recibir de la app Django (rama smartbite)&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=13;fontSize=20;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1640" height="50" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;sd Recibir una compra&lt;/b&gt;" style="shape=umlFrame;whiteSpace=wrap;html=1;pointerEvents=0;width=179;height=26;fillColor=none;strokeColor=#666666;align=left;spacingLeft=6;fontFamily=Helvetica;fontSize=13;fontSize=12;" vertex="1" parent="1"><mxGeometry x="30" y="96" width="1660" height="1050" as="geometry"/></mxCell><mxCell id="c4" value="«vista»&lt;br&gt;:compra_recibir" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Helvetica;fontSize=13;fontSize=12;" vertex="1" parent="1"><mxGeometry x="320.0" y="600.0" width="220" height="60" as="geometry"/></mxCell><mxCell id="c5" value="d: DetalleCompra" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Helvetica;fontSize=13;fontSize=12;" vertex="1" parent="1"><mxGeometry x="880.0" y="150.0" width="200" height="60" as="geometry"/></mxCell><mxCell id="c6" value="compra: Compra" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Helvetica;fontSize=13;fontSize=12;" vertex="1" parent="1"><mxGeometry x="880.0" y="450.0" width="200" height="60" as="geometry"/></mxCell><mxCell id="c7" value="item: ItemInventario" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Helvetica;fontSize=13;fontSize=12;" vertex="1" parent="1"><mxGeometry x="875.0" y="750.0" width="210" height="60" as="geometry"/></mxCell><mxCell id="c8" value=":MovimientoInventario" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Helvetica;fontSize=13;fontSize=12;" vertex="1" parent="1"><mxGeometry x="865.0" y="1030.0" width="230" height="60" as="geometry"/></mxCell><mxCell id="c9" value="bd: PostgreSQL" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontFamily=Helvetica;fontSize=13;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1410.0" y="750.0" width="180" height="60" as="geometry"/></mxCell><mxCell id="c10" value="Jefe de Inventario" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontFamily=Helvetica;fontSize=13;fillColor=#ffffff;strokeColor=#333333;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="90" y="590" width="40" height="80" as="geometry"/></mxCell><mxCell id="c11" value="" style="endArrow=none;html=1;strokeColor=#333333;strokeWidth=1.2;fontFamily=Helvetica;fontSize=13;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c10" target="c4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c12" value="" style="endArrow=none;html=1;strokeColor=#333333;strokeWidth=1.2;fontFamily=Helvetica;fontSize=13;" edge="1" parent="1" source="c4" target="c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c13" value="" style="endArrow=none;html=1;strokeColor=#333333;strokeWidth=1.2;fontFamily=Helvetica;fontSize=13;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c14" value="" style="endArrow=none;html=1;strokeColor=#333333;strokeWidth=1.2;fontFamily=Helvetica;fontSize=13;" edge="1" parent="1" source="c4" target="c7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c15" value="" style="endArrow=none;html=1;strokeColor=#333333;strokeWidth=1.2;fontFamily=Helvetica;fontSize=13;" edge="1" parent="1" source="c4" target="c8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c16" value="" style="endArrow=none;html=1;strokeColor=#333333;strokeWidth=1.2;fontFamily=Helvetica;fontSize=13;" edge="1" parent="1" source="c6" target="c9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c17" value="" style="endArrow=none;html=1;strokeColor=#333333;strokeWidth=1.2;fontFamily=Helvetica;fontSize=13;" edge="1" parent="1" source="c7" target="c9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c18" value="" style="endArrow=none;html=1;strokeColor=#333333;strokeWidth=1.2;fontFamily=Helvetica;fontSize=13;" edge="1" parent="1" source="c8" target="c9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c19" value="" style="endArrow=none;html=1;strokeColor=#333333;strokeWidth=1.2;fontFamily=Helvetica;fontSize=13;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="380" y="600.0" as="sourcePoint"/><mxPoint x="480" y="600.0" as="targetPoint"/><Array as="points"><mxPoint x="380" y="550.0"/><mxPoint x="480" y="550.0"/></Array></mxGeometry></mxCell><mxCell id="c20" value="" style="html=1;endArrow=block;endFill=1;endSize=7;strokeColor=#333333;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="410" y="536.0" as="sourcePoint"/><mxPoint x="456" y="536.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c21" value="1.1: compra := get_object_or_404(Compra, pk),&lt;br&gt;1.2: usuario_tiene_rol(usuario, ROLES_INVENTARIO)" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontSize=12;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="130" y="488.0" width="420" height="40" as="geometry"/></mxCell><mxCell id="c22" value="" style="html=1;endArrow=block;endFill=1;endSize=7;strokeColor=#333333;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="207" y="614" as="sourcePoint"/><mxPoint x="253" y="614" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c23" value="1: POST&lt;br&gt;compras/{pk}/recibir/" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontSize=12;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="156" y="570" width="148" height="36" as="geometry"/></mxCell><mxCell id="c24" value="" style="html=1;endArrow=block;endFill=1;endSize=7;strokeColor=#333333;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="671" y="581" as="sourcePoint"/><mxPoint x="715" y="569" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c25" value="1.3 [compra.estado = PENDIENTE]:&lt;br&gt;detalles.select_related(&amp;#x27;item&amp;#x27;),&lt;br&gt;1.7: estado := RECIBIDA,&lt;br&gt;save(update_fields = [&amp;#x27;estado&amp;#x27;])" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontSize=12;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="600" y="608" width="221" height="66" as="geometry"/></mxCell><mxCell id="c26" value="" style="html=1;endArrow=block;endFill=1;endSize=7;strokeColor=#333333;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="732" y="362" as="sourcePoint"/><mxPoint x="768" y="333" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c27" value="1.4 *[para cada detalle d]:&lt;br&gt;item, cantidad" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontSize=12;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="604" y="267" width="188" height="36" as="geometry"/></mxCell><mxCell id="c28" value="" style="html=1;endArrow=block;endFill=1;endSize=7;strokeColor=#333333;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="869" y="733" as="sourcePoint"/><mxPoint x="913" y="745" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c29" value="1.5 *[para cada detalle d]:&lt;br&gt;stock_actual += cantidad,&lt;br&gt;save(update_fields = [&amp;#x27;stock_actual&amp;#x27;])" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontSize=12;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="778" y="649" width="260" height="51" as="geometry"/></mxCell><mxCell id="c30" value="" style="html=1;endArrow=block;endFill=1;endSize=7;strokeColor=#333333;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="732" y="886" as="sourcePoint"/><mxPoint x="768" y="915" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c31" value="1.6 *[para cada detalle d]:&lt;br&gt;objects.create(item, tipo = ENTRADA,&lt;br&gt;cantidad, motivo = &amp;#x27;Recepción compra #pk&amp;#x27;)" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontSize=12;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="535" y="967" width="287" height="51" as="geometry"/></mxCell><mxCell id="c32" value="" style="html=1;endArrow=block;endFill=1;endSize=7;strokeColor=#333333;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1228" y="605" as="sourcePoint"/><mxPoint x="1268" y="628" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c33" value="1.7.1: UPDATE estado" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontSize=12;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="1203" y="560" width="142" height="21" as="geometry"/></mxCell><mxCell id="c34" value="" style="html=1;endArrow=block;endFill=1;endSize=7;strokeColor=#333333;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1217" y="764" as="sourcePoint"/><mxPoint x="1263" y="764" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c35" value="1.5.1: UPDATE stock_actual" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontSize=12;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="1150" y="735" width="181" height="21" as="geometry"/></mxCell><mxCell id="c36" value="" style="html=1;endArrow=block;endFill=1;endSize=7;strokeColor=#333333;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1227" y="945" as="sourcePoint"/><mxPoint x="1268" y="923" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c37" value="1.6.1: INSERT movimiento" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontSize=12;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="1191" y="974" width="168" height="21" as="geometry"/></mxCell><mxCell id="c38" value="1.3 a 1.7 solo pasan si la compra está PENDIENTE, y todo dentro de transaction.atomic(): se confirma junto o no se guarda nada. 1.4, 1.5 y 1.6 se repiten juntas por cada detalle (primero se suma el stock del ítem y después se crea su ENTRADA). Si la compra no está PENDIENTE, no cambia nada." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=8;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Helvetica;fontSize=13;fontSize=11;" vertex="1" parent="1"><mxGeometry x="30" y="1170" width="820" height="66" as="geometry"/></mxCell><mxCell id="c39" value="Ejemplo: una compra PENDIENTE con 10 L de leche (stock 0) deja la leche en stock 10, una ENTRADA de 10 con motivo «Recepción compra #N» y la compra RECIBIDA. bd = PostgreSQL en Neon (smartbite_app) o SQLite." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=8;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Helvetica;fontSize=13;fontSize=11;" vertex="1" parent="1"><mxGeometry x="870" y="1170" width="820" height="66" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>