xGeometry x="1" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="c28" value="" style="endArrow=none;html=1;strokeColor=#333333;strokeWidth=1.2;fontFamily=Helvetica;fontSize=13;exitX=0;exitY=0.8468;entryX=1;entryY=0.0819;" edge="1" parent="1" source="c12" target="c9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c29" value="movimientos" style="edgeLabel;resizable=0;html=1;align=right;verticalAlign=bottom;fontFamily=Helvetica;fontSize=13;" vertex="1" connectable="0" parent="c28"><mxGeometry x="-1" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="c30" value="item" style="edgeLabel;resizable=0;html=1;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=13;" vertex="1" connectable="0" parent="c28"><mxGeometry x="1" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="c31" value="" style="endArrow=none;html=1;strokeColor=#333333;strokeWidth=1.2;fontFamily=Helvetica;fontSize=13;exitX=0;exitY=0.1532;entryX=1;entryY=0.9181;" edge="1" parent="1" source="c14" target="c9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c32" value="movimientos" style="edgeLabel;resizable=0;html=1;align=right;verticalAlign=bottom;fontFamily=Helvetica;fontSize=13;" vertex="1" connectable="0" parent="c31"><mxGeometry x="-1" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="c33" value="item" style="edgeLabel;resizable=0;html=1;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=13;" vertex="1" connectable="0" parent="c31"><mxGeometry x="1" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="c34" value="Cómo se llegó acá: «Leche entera» se creó con stock 0 (item_crear). Al recibir la compra #3 (compra_recibir) el stock pasó a 10 y se creó la ENTRADA e1. La salida de 7 (item_ajustar_stock) lo dejó en 3 y creó la SALIDA s1. Como 3 ≤ 5, stock_bajo = true y el listado la marca «Stock bajo». Ningún campo guarda el stock anterior: se reconstruye con los movimientos (0 + 10 − 7 = 3)." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=8;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Helvetica;fontSize=13;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="681" width="1650" height="56" as="geometry"/></mxCell><mxCell id="c35" value="Línea sólida = enlace (instancia de una asociación del diagrama de clases); los nombres en los extremos son los related_name y las FK. En verde, lo que dejó la recepción de la compra (diagrama de comunicación); en amarillo, el movimiento del diagrama de secuencia. centro es de otra app: se muestra sin sus atributos." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=8;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Helvetica;fontSize=13;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="747" width="1650" height="56" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>