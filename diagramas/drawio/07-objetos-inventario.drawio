<mxfile host="drawio_lib"><diagram id="d1" name="Objetos - Inventario"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1240" pageHeight="945" background="#ffffff" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="&lt;b&gt;Diagrama de objetos — Inventario (Smart Bite)&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:13px' color='#555555'&gt;Foto de los datos justo después de la salida del diagrama de secuencia: Leche entera con stock 10 y mínimo 5, salida de 7&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=13;fontSize=20;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1160" height="50" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;&lt;u&gt;lacteos : CategoriaInsumo&lt;/u&gt;&lt;/b&gt;" style="swimlane;fontStyle=0;html=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=26;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Helvetica;fontSize=13;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="490" y="110" width="260" height="66" as="geometry"/></mxCell><mxCell id="c4" value="id = 1&lt;br&gt;nombre = &amp;quot;Lácteos&amp;quot;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;overflow=hidden;rotatable=0;fontFamily=Helvetica;fontSize=13;fontSize=12;whiteSpace=wrap;" vertex="1" parent="c3"><mxGeometry x="0" y="26" width="260" height="40" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;&lt;u&gt;sucursal1 : Restaurantes::Sucursal&lt;/u&gt;&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontFamily=Helvetica;fontSize=13;" vertex="1" parent="1"><mxGeometry x="860" y="120" width="300" height="50" as="geometry"/></mxCell><mxCell id=