lative="1" as="geometry"><Array as="points"><mxPoint x="390" y="606"/><mxPoint x="390" y="477"/></Array></mxGeometry></mxCell><mxCell id="c24" value="" style="endArrow=none;html=1;strokeColor=#333333;strokeWidth=1.2;fontFamily=Helvetica;fontSize=13;edgeStyle=orthogonalEdgeStyle;rounded=0;exitX=0.6;exitY=0;entryX=0.6;entryY=1;" edge="1" parent="1" source="c15" target="c7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c25" value="usuario_id" style="endArrow=open;endSize=10;dashed=1;html=1;strokeColor=#666666;fontColor=#444444;fontFamily=Helvetica;fontSize=13;fontSize=12;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="c13" target="c17"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c26" value="Cómo se llegó acá: el insumo se creó con stock 0 y el código lo generó la base (LAC + secuencial por sucursal); después se configuró el mínimo en 5 (queda en el historial); una ENTRADA de 10 dejó stock 10; la SALIDA de 7 dejó stock 3, bajo el mínimo, y la base creó la solicitud por 5 − 3 = 2." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=8;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Helvetica;fontSize=13;fontSize=12;" vertex="1" parent="1"><mxGeometry x="420" y="731" width="740" height="80" as="geometry"/></mxCell><mxCell id="c27" value="Enlaces sólidos = FK reales; punteados = referencias a tablas de otros módulos (sin FK física todavía)." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontSize=12;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="420" y="826" width="740" height="20" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>