mily=Helvetica;fontSize=13;fontSize=11;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="1310" y="282" width="200" height="34" as="geometry"/></mxCell><mxCell id="c48" value="&lt;b&gt;INSERTS&lt;/b&gt;" style="shape=folder;tabWidth=80;tabHeight=24;tabPosition=left;html=1;whiteSpace=wrap;fillColor=#e1d5e7;strokeColor=#9673a6;fontFamily=Helvetica;fontSize=13;fontSize=13;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="1190" y="400" width="420" height="110" as="geometry"/></mxCell><mxCell id="c49" value="SMARTBITE_INVENTARIO_SP.sql — categorías de insumo&lt;br&gt;(Lácteos, Cárnicos, …)&lt;br&gt;SMARTBITE_COMPRAS_SP.sql — métodos de pago" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontSize=11;fontColor=#333333;" vertex="1" parent="c48"><mxGeometry x="8" y="30" width="404" height="74" as="geometry"/></mxCell><mxCell id="c50" value="&lt;b&gt;tests&lt;/b&gt;" style="shape=folder;tabWidth=80;tabHeight=24;tabPosition=left;html=1;whiteSpace=wrap;fillColor=#e1d5e7;strokeColor=#9673a6;fontFamily=Helvetica;fontSize=13;fontSize=13;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="1190" y="570" width="420" height="120" as="geometry"/></mxCell><mxCell id="c51" value="conftest.py, test_*.py (pytest + psycopg2)&lt;br&gt;contra una rama de prueba de Neon; el fixture&lt;br&gt;aplica INVENTARIO y después COMPRAS" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontSize=11;fontColor=#333333;" vertex="1" parent="c50"><mxGeometry x="8" y="30" width="404" height="84" as="geometry"/></mxCell><mxCell id="c52" value="«use» carga datos semilla" style="endArrow=open;endSize=10;dashed=1;html=1;strokeColor=#555555;fontColor=#333333;fontFamily=Helvetica;fontSize=13;fontSize=12;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0;entryX=0.5;entryY=1;" edge="1" parent="1" source="c48" target="c39"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c53" value="" style="endArrow=open;endSize=10;dashed=1;html=1;strokeColor=#555555;fontColor=#333333;fontFamily=Helvetica;fontSize=13;fontSize=12;labelBackgroundColor=#ffffff;exitX=1;exitY=0.3;entryX=1;entryY=0.8;" edge="1" parent="1" source="c50" target="c39"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1650" y="606"/><mxPoint x="1650" y="297"/></Array></mxGeometry></mxCell><mxCell id="c54" value="«use»&lt;br&gt;aplica&lt;br&gt;y prueba" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontSize=11;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="1656" y="420" width="60" height="50" as="geometry"/></mxCell><mxCell id="c55" value="Hoy Django corre sobre SQLite con sus propios modelos. Alinearlos con el esquema de Neon (y pasar Django a PostgreSQL) es la spec 003." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=8;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Helvetica;fontSize=13;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1190" y="840" width="510" height="50" as="geometry"/></mxCell><mxCell id="c56" value="" style="endArrow=none;dashed=1;html=1;strokeColor=#999999;exitX=0;exitY=0.5;entryX=1;entryY=0.85;" edge="1" parent="1" source="c55" target="c17"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c57" value="" style="endArrow=none;dashed=1;html=1;strokeColor=#999999;exitX=0.5;exitY=0;entryX=0.5;entryY=1;" edge="1" parent="1" source="c55" target="c37"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c58" value="«import» = el paquete importa clases del otro (from x.models import …). «use» = depende de él de otra forma: FK por string (&amp;quot;app.Modelo&amp;quot;), plantilla heredada o datos que lee. La flecha va del que depende al que se usa." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=8;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Helvetica;fontSize=13;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="975" width="1120" height="46" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>