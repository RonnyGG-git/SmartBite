<mxfile host="drawio_lib"><diagram id="d1" name="Secuencia - Registrar salida"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1720" pageHeight="1140" background="#ffffff" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="&lt;b&gt;Diagrama de secuencia — Registrar salida de inventario (CU-INV-06)&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:13px' color='#555555'&gt;Del formulario de Django a los triggers de PostgreSQL (Neon): control de stock (RF-13, RF-14) y solicitud automática de reabastecimiento (RF-28, RF-29)&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=13;fontSize=20;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1640" height="50" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;sd Registrar salida de inventario&lt;/b&gt;" style="shape=umlFrame;whiteSpace=wrap;html=1;pointerEvents=0;width=268;height=26;fillColor=none;strokeColor=#666666;align=left;spacingLeft=6;fontFamily=Helvetica;fontSize=13;fontSize=12;" vertex="1" parent="1"><mxGeometry x="30" y="96" width="1660" height="884" as="geometry"/></mxCell><mxCell id="c4" value="" style="shape=umlActor;html=1;outlineConnect=0;fillColor=#ffffff;strokeColor=#333333;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="85" y="140" width="30" height="52" as="geometry"/></mxCell><mxCell id="c5" value="Jefe de Almacén" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontSize=12;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="30" y="194" width="140" height="20" as="geometry"/></mxCell><mxCell id="c6" value="" style="endArrow=none;dashed=1;html=1;strokeColor=#333333;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="100" y="216" as="sourcePoint"/><mxPoint x="100" y="960" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c7" value="«vi