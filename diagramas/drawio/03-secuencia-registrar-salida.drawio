elvetica;fontSize=13;fontSize=12;verticalAlign=bottom;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="821" y="400" as="sourcePoint"/><mxPoint x="1064" y="400" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c26" value="stock_actual" style="html=1;endArrow=open;dashed=1;endSize=8;strokeColor=#333333;fontFamily=Helvetica;fontSize=13;fontSize=12;verticalAlign=bottom;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1064" y="428" as="sourcePoint"/><mxPoint x="821" y="428" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c27" value="&lt;b&gt;alt&lt;/b&gt;" style="shape=umlFrame;whiteSpace=wrap;html=1;pointerEvents=0;width=60;height=26;fillColor=none;strokeColor=#666666;fontFamily=Helvetica;fontSize=13;fontSize=12;" vertex="1" parent="1"><mxGeometry x="50" y="450" width="1620" height="470" as="geometry"/></mxCell><mxCell id="c28" value="[stock_actual − cantidad &amp;lt; 0]  (RF-14)" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontSize=12;fontColor=#444444;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="116" y="453" width="262" height="20" as="geometry"/></mxCell><mxCell id="c29" value="6: RAISE 'Stock insuficiente…'" style="html=1;endArrow=open;dashed=1;endSize=8;strokeColor=#333333;fontFamily=Helvetica;fontSize=13;fontSize=12;verticalAlign=bottom;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="809" y="495" as="sourcePoint"/><mxPoint x="551" y="495" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c30" value="7: error check_violation (ROLLBACK)" style="html=1;endArrow=open;dashed=1;endSize=8;strokeColor=#333333;fontFamily=Helvetica;fontSize=13;fontSize=12;verticalAlign=bottom;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="539" y="528" as="sourcePoint"/><mxPoint x="306" y="528" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c31" value="8: muestra el error" style="html=1;endArrow=open;dashed=1;endSize=8;strokeColor=#333333;fontFamily=Helvetica;fontSize=13;fontSize=12;verticalAlign=bottom;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="294" y="560" as="sourcePoint"/><mxPoint x="106" y="560" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c32" value="" style="endArrow=none;dashed=1;html=1;strokeColor=#666666;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="50" y="585" as="sourcePoint"/><mxPoint x="1670" y="585" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c33" value="[else]" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontSize=12;fontColor=#444444;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="58" y="588" width="51" height="20" as="geometry"/></mxCell><mxCell id="c34" value="9: UPDATE stock_actual = stock_nuevo  (RF-13)" style="html=1;endArrow=block;endFill=1;strokeColor=#333333;fontFamily=Helvetica;fontSize=13;fontSize=12;verticalAlign=bottom;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="821" y="630" as="sourcePoint"/><mxPoint x="1064" y="630" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c35" value="10: fn_generar_solicitud_si_hace_falta(item_inventario_id, stock_nuevo)" style="html=1;endArrow=block;endFill=1;strokeColor=#333333;fontFamily=Helvetica;fontSize=13;fontSize=12;verticalAlign=bottom;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="821" y="675" as="sourcePoint"/><mxPoint x="1314" y="675" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c36" value="&lt;b&gt;opt&lt;/b&gt;" style="shape=umlFrame;whiteSpace=wrap;html=1;pointerEvents=0;width=50;height=26;fillColor=none;strokeColor=#666666;fontFamily=Helvetica;fontSize=13;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1060" y="695" width="590" height="80" as="geometry"/></mxCell><mxCell id="c37" value="[stock_minimo no es NULL y stock_nuevo &amp;lt; stock_minimo]" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontSize=12;fontColor=#444444;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="1116" y="698" width="368" height="20" as="geometry"/></mxCell><mxCell id="c38" value="11: INSERT (cantidad_sugerida = stock_minimo − stock_nuevo)" style="html=1;endArrow=block;endFill=1;strokeColor=#333333;fontFamily=Helvetica;fontSize=13;fontSize=12;verticalAlign=bottom;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1326" y="745" as="sourcePoint"/><mxPoint x="1559" y="745" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c39" value="12: NEW con stock_anterior y stock_nuevo" style="html=1;endArrow=open;dashed=1;endSize=8;strokeColor=#333333;fontFamily=Helvetica;fontSize=13;fontSize=12;verticalAlign=bottom;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="809" y="820" as="sourcePoint"/><mxPoint x="551" y="820" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c40" value="13: INSERT confirmado (COMMIT)" style="html=1;endArrow=open;dashed=1;endSize=8;strokeColor=#333333;fontFamily=Helvetica;fontSize=13;fontSize=12;verticalAlign=bottom;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="539" y="860" as="sourcePoint"/><mxPoint x="306" y="860" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c41" value="14: redirige al listado" style="html=1;endArrow=open;dashed=1;endSize=8;strokeColor=#333333;fontFamily=Helvetica;fontSize=13;fontSize=12;verticalAlign=bottom;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="294" y="900" as="sourcePoint"/><mxPoint x="106" y="900" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c42" value="Ejemplo (el mismo del diagrama de objetos): Leche entera con stock 10 y mínimo 5. Salida de 7 → stock 3 → solicitud PENDIENTE de 2." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=8;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Helvetica;fontSize=13;fontSize=12;" vertex="1" parent="1"><mxGeometry x="30" y="1010" width="520" height="54" as="geometry"/></mxCell><mxCell id="c43" value="RF-29: si el insumo ya tiene una solicitud PENDIENTE, el índice único rechaza la segunda (unique_violation), la función la ignora y el movimiento sigue." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=8;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Helvetica;fontSize=13;fontSize=12;" vertex="1" parent="1"><mxGeometry x="570" y="1010" width="520" height="54" as="geometry"/></mxCell><mxCell id="c44" value="Antes de este trigger corre trg_movimiento_inventario_10_evitar_perdida_duplicada (solo actúa en pérdidas por vencimiento, RF-38). Hoy la vista de Django suma y resta stock_actual en Python; se adapta en la spec 003." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=8;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Helvetica;fontSize=13;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1110" y="1010" width="580" height="54" as="geometry"/></mxCell><mxCell id="c45" value="Palabras clave de las cabeceras: «vista» = función de inventario/views.py (Django); «table» = tabla; «trigger» = trigger de PostgreSQL; «function» = función de PostgreSQL. Flecha llena = llamada síncrona; punteada = respuesta." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=8;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Helvetica;fontSize=13;fontSize=12;" vertex="1" parent="1"><mxGeometry x="30" y="1076" width="1660" height="40" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>