tSize=12;verticalAlign=bottom;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1144" y="896" as="sourcePoint"/><mxPoint x="336" y="896" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c43" value="11: redirige al listado de inventario" style="html=1;endArrow=open;dashed=1;endSize=8;strokeColor=#333333;fontFamily=Helvetica;fontSize=13;fontSize=12;verticalAlign=bottom;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="324" y="945" as="sourcePoint"/><mxPoint x="106" y="945" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c44" value="Ejemplo (el mismo del diagrama de objetos): Leche entera con stock 10 y mínimo 5. Salida de 7 → stock 3; como 3 ≤ 5, el listado la marca «Stock bajo». No se genera ninguna solicitud de reabastecimiento." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=8;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Helvetica;fontSize=13;fontSize=11;" vertex="1" parent="1"><mxGeometry x="30" y="1030" width="450" height="70" as="geometry"/></mxCell><mxCell id="c45" value="Si la salida supera el stock, no se rechaza: max(0, …) deja stock_actual en 0 y el movimiento igual guarda la cantidad pedida. El movimiento no guarda qué usuario lo registró." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=8;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Helvetica;fontSize=13;fontSize=11;" vertex="1" parent="1"><mxGeometry x="495" y="1030" width="440" height="70" as="geometry"/></mxCell><mxCell id="c46" value="critical = transaction.atomic(): el UPDATE y el INSERT se confirman juntos o no se guarda ninguno. bd = PostgreSQL en Neon (base smartbite_app) cuando el .env define DATABASE_URL; si no, SQLite." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=8;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Helvetica;fontSize=13;fontSize=11;" vertex="1" parent="1"><mxGeometry x="950" y="1030" width="560" height="70" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>