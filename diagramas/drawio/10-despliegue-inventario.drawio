<mxfile host="drawio_lib"><diagram id="d1" name="Despliegue - Inventario"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="780" background="#ffffff" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="&lt;b&gt;Diagrama de despliegue — Inventario (Smart Bite)&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:13px' color='#555555'&gt;Dónde corre hoy la app Django y cómo se conecta con la base de datos en Neon&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=13;fontSize=20;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1520" height="50" as="geometry"/></mxCell><mxCell id="c3" value="«device»&lt;br&gt;&lt;b&gt;Computadora de desarrollo (cada integrante)&lt;/b&gt;" style="shape=cube;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;darkOpacity=0.05;darkOpacity2=0.1;size=12;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontFamily=Helvetica;fontSize=13;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="900" height="470" as="geometry"/></mxCell><mxCell id="c4" value="«executionEnvironment»&lt;br&gt;&lt;b&gt;Navegador web&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;http://127.0.0.1:8000&lt;/font&gt;" style="shape=cube;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;darkOpacity=0.05;darkOpacity2=0.1;size=12;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Helvetica;fontSize=13;fontSize=12;" vertex="1" parent="1"><mxGeometry x="70" y="215" width="220" height="100" as="geometry"/></mxCell><mxCell id="c5" value="«executionEnvironment»&lt;br&gt;&lt;b&gt;Python 3.14 + Django 5.2 (venv)&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;manage.py runserver (servidor de desarrollo)&lt;/font&gt;" style="shape=cube;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;darkOpacity=0.05;darkOpacity2=0.1;size=12;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Helvetica;fontSize=13;fontSize=12;" vertex="1" parent="1"><mxGeometry x="380" y="175" width="530" height="215" as="geometry"/></mxCell><mxCell id="c6" value="«artifact»&lt;br&gt;&lt;b&gt;smartbite&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;código del repo: apps de&lt;br&gt;Django y sus migraciones&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;spacingRight=16;fillColor=#ffffff;strokeColor=#333333;fontFamily=Helvetica;fontSize=13;fontSize=12;" vertex="1" parent="1"><mxGeometry x="410" y="265" width="230" height="84" as="geometry"/></mxCell><mxCell id="c7" value="" style="shape=note;size=5;html=1;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="c6"><mxGeometry x="210" y="6" width="12" height="15" as="geometry"/></mxCell><mxCell id="c8" value="«source»&lt;br&gt;&lt;b&gt;settings.py&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;usa DATABASE_URL si existe;&lt;br&gt;si no, db.sqlite3&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;spacingRight=16;fillColor=#ffffff;strokeColor=#333333;fontFamily=Helvetica;fontSize=13;fontSize=12;" vertex="1" parent="1"><mxGeometry x="660" y="265" width="220" height="84" as="geometry"/></mxCell><mxCell id="c9" value="" style="shape=note;size=5;html=1;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="c8"><mxGeometry x="200" y="6" width="12" height="15" as="geometry"/></mxCell><mxCell id="c10" value="«file»&lt;br&gt;&lt;b&gt;.env&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;DATABASE_URL de Neon&lt;br&gt;(no se sube al repo)&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;spacingRight=16;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontFamily=Helvetica;fontSize=13;fontSize=12;" vertex="1" parent="1"><mxGeometry x="380" y="450" width="250" height="90" as="geometry"/></mxCell><mxCell id="c11" value="" style="shape=note;size=5;html=1;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="c10"><mxGeometry x="230" y="6" width="12" height="15" as="geometry"/></mxCell><mxCell id="c12" value="«file»&lt;br&gt;&lt;b&gt;db.sqlite3&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;solo si no hay DATABASE_URL&lt;br&gt;(no se sube al repo)&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;spacingRight=16;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontFamily=Helvetica;fontSize=13;fontSize=12;" vertex="1" parent="1"><mxGeometry x="660" y="450" width="250" height="90" as="geometry"/></mxCell><mxCell id="c13" value="" style="shape=note;size=5;html=1;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="c12"><mxGeometry x="230" y="6" width="12" height="15" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;Neon (PostgreSQL gestionado en la nube)&lt;/b&gt;" style="shape=cube;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;darkOpacity=0.05;darkOpacity2=0.1;size=12;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontFamily=Helvetica;fontSize=13;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1080" y="110" width="480" height="470" as="geometry"/></mxCell><mxCell id="c15" value="«executionEnvironment»&lt;br&gt;&lt;b&gt;PostgreSQL — rama test-inventario-jose&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;base smartbite_app: las tablas de Django&lt;br&gt;(inventario_iteminventario, …),&lt;br&gt;creadas con manage.py migrate&lt;/font&gt;" style="shape=cube;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;darkOpacity=0.05;darkOpacity2=0.1;size=12;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fillColor=#d5e8d4;strokeColor=#82b366;fontFamily=Helvetica;fontSize=13;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1110" y="200" width="420" height="170" as="geometry"/></mxCell><mxCell id="c16" value="" style="endArrow=none;html=1;strokeColor=#333333;strokeWidth=1.2;fontFamily=Helvetica;fontSize=13;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="290" y="265" as="sourcePoint"/><mxPoint x="380" y="265" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c17" value="«HTTP»" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontSize=12;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="292" y="243" width="86" height="18" as="geometry"/></mxCell><mxCell id="c18" value="" style="endArrow=none;html=1;strokeColor=#333333;strokeWidth=1.2;fontFamily=Helvetica;fontSize=13;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="910" y="300" as="sourcePoint"/><mxPoint x="1110" y="300" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c19" value="«PostgreSQL/TLS»&lt;br&gt;sslmode=require" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontSize=11;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="920" y="260" width="180" height="36" as="geometry"/></mxCell><mxCell id="c20" value="{solo si el .env define&lt;br&gt;DATABASE_URL}" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontSize=11;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="920" y="306" width="180" height="34" as="geometry"/></mxCell><mxCell id="c21" value="Producción: no definida. Esta configuración es solo de desarrollo (DEBUG = True, ALLOWED_HOSTS vacío y la SECRET_KEY de ejemplo en settings.py). Dónde se aloja Django, qué base de Neon usa el equipo y cómo se respalda queda por decidir; por eso no se dibuja un servidor de producción." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=8;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Helvetica;fontSize=13;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="610" width="760" height="70" as="geometry"/></mxCell><mxCell id="c22" value="El código se comparte por GitHub (RonnyGG-git/SmartBite) y cada integrante lo corre en su computadora con su propio .env. Si alguien no tiene .env, Django usa db.sqlite3 local y no toca Neon." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=8;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Helvetica;fontSize=13;fontSize=11;" vertex="1" parent="1"><mxGeometry x="820" y="610" width="740" height="70" as="geometry"/></mxCell><mxCell id="c23" value="Cubo = nodo («device» = máquina física; «executionEnvironment» = software que ejecuta otros artefactos). Rectángulo con hoja = artefacto desplegado en el nodo que lo contiene. Línea sólida = camino de comunicación con su protocolo; {…} = condición." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=8;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Helvetica;fontSize=13;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="700" width="1520" height="46" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>