ex="1" parent="1"><mxGeometry x="870" y="600" width="200" height="74" as="geometry"/></mxCell><mxCell id="c17" value="" style="shape=note;size=5;html=1;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="c16"><mxGeometry x="180" y="6" width="12" height="15" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b&gt;Neon (PostgreSQL gestionado en la nube)&lt;/b&gt;" style="shape=cube;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;darkOpacity=0.05;darkOpacity2=0.1;size=12;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontFamily=Helvetica;fontSize=13;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1260" y="110" width="460" height="700" as="geometry"/></mxCell><mxCell id="c19" value="«executionEnvironment»&lt;br&gt;&lt;b&gt;PostgreSQL — rama principal&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;la base del equipo; los scripts se aplican&lt;br&gt;cuando pasan las pruebas; Django la usará&lt;br&gt;con la spec 003&lt;/font&gt;" style="shape=cube;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;darkOpacity=0.05;darkOpacity2=0.1;size=12;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fillColor=#d5e8d4;strokeColor=#82b366;fontFamily=Helvetica;fontSize=13;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1290" y="185" width="400" height="170" as="geometry"/></mxCell><mxCell id="c20" value="«executionEnvironment»&lt;br&gt;&lt;b&gt;PostgreSQL — rama de prueba&lt;br&gt;(test-inventario-jose)&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;el esquema se borra y se recrea&lt;br&gt;en cada corrida de los tests&lt;/font&gt;" style="shape=cube;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;darkOpacity=0.05;darkOpacity2=0.1;size=12;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Helvetica;fontSize=13;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1290" y="500" width="400" height="180" as="geometry"/></mxCell><mxCell id="c21" value="" style="endArrow=none;html=1;strokeColor=#333333;strokeWidth=1.2;fontFamily=Helvetica;fontSize=13;exitX=1;exitY=0.45;entryX=0;entryY=0.36;" edge="1" parent="1" source="c4" target="c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c22" value="«HTTP»" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontSize=12;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="330" y="252" width="80" height="18" as="geometry"/></mxCell><mxCell id="c23" value="" style="endArrow=none;html=1;strokeColor=#333333;strokeWidth=1.2;fontFamily=Helvetica;fontSize=13;exitX=1;exitY=0.25;entryX=0;entryY=0.17;" edge="1" parent="1" source="c11" target="c20"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c24" value="«PostgreSQL/TLS»&lt;br&gt;(sslmode=require)" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontSize=11;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="1100" y="494" width="130" height="34" as="geometry"/></mxCell><mxCell id="c25" value="" style="endArrow=none;html=1;strokeColor=#333333;strokeWidth=1.2;fontFamily=Helvetica;fontSize=13;strokeColor=#b85450;fontColor=#b85450;exitX=0.75;exitY=0;entryX=0.5;entryY=0;" edge="1" parent="1" source="c6" target="c19"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="740" y="92"/><mxPoint x="1490" y="92"/></Array></mxGeometry></mxCell><mxCell id="c26" value="«PostgreSQL/TLS» {planificado: spec 003}" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontSize=11;fontColor=#b85450;" vertex="1" parent="1"><mxGeometry x="880" y="72" width="360" height="18" as="geometry"/></mxCell><mxCell id="c27" value="" style="rounded=0;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="1107" y="729" width="2" height="2" as="geometry"/></mxCell><mxCell id="c28" value="" style="endArrow=none;dashed=1;html=1;strokeColor=#555555;edgeStyle=orthogonalEdgeStyle;rounded=0;exitX=0.5;exitY=1;entryX=0.5;entryY=0.5;" edge="1" parent="1" source="c12" target="c27"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="545" y="730"/></Array></mxGeometry></mxCell><mxCell id="c29" value="" style="rounded=0;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="1107" y="729" width="2" height="2" as="geometry"/></mxCell><mxCell id="c30" value="" style="endArrow=none;dashed=1;html=1;strokeColor=#555555;edgeStyle=orthogonalEdgeStyle;rounded=0;exitX=0.5;exitY=1;entryX=0.5;entryY=0.5;" edge="1" parent="1" source="c14" target="c29"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="755" y="730"/></Array></mxGeometry></mxCell><mxCell id="c31" value="" style="ellipse;html=1;fillColor=#555555;strokeColor=#555555;" vertex="1" parent="1"><mxGeometry x="1104" y="726" width="8" height="8" as="geometry"/></mxCell><mxCell id="c32" value="" style="endArrow=open;endSize=10;dashed=1;html=1;strokeColor=#555555;fontColor=#333333;fontFamily=Helvetica;fontSize=13;fontSize=12;labelBackgroundColor=#ffffff;edgeStyle=orthogonalEdgeStyle;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1108" y="730" as="sourcePoint"/><mxPoint x="1290" y="650" as="targetPoint"/><Array as="points"><mxPoint x="1230" y="730"/><mxPoint x="1230" y="650"/></Array></mxGeometry></mxCell><mxCell id="c33" value="«deploy»&lt;br&gt;en cada corrida" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontSize=11;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="1206" y="690" width="100" height="34" as="geometry"/></mxCell><mxCell id="c34" value="" style="endArrow=open;endSize=10;dashed=1;html=1;strokeColor=#555555;fontColor=#333333;fontFamily=Helvetica;fontSize=13;fontSize=12;labelBackgroundColor=#ffffff;edgeStyle=orthogonalEdgeStyle;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1108" y="730" as="sourcePoint"/><mxPoint x="1290" y="320" as="targetPoint"/><Array as="points"><mxPoint x="1108" y="320"/></Array></mxGeometry></mxCell><mxCell id="c35" value="«deploy» cuando&lt;br&gt;pasan las pruebas&lt;br&gt;(principio 7)" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontSize=11;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="1126" y="372" width="130" height="50" as="geometry"/></mxCell><mxCell id="c36" value="Producción: no definida. Dónde se aloja Django y cómo se respalda la base es una decisión pendiente del equipo (ADR, principio 9 de la constitución); por eso no se dibuja un servidor de producción." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=8;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Helvetica;fontSize=13;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="840" width="820" height="50" as="geometry"/></mxCell><mxCell id="c37" value="El código se comparte por GitHub (RonnyGG-git/SmartBite) y cada integrante lo corre en su computadora: en desarrollo, el navegador y el servidor suelen ser la misma máquina. En rojo: la conexión que llega con la spec 003." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=8;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Helvetica;fontSize=13;fontSize=11;" vertex="1" parent="1"><mxGeometry x="880" y="840" width="830" height="50" as="geometry"/></mxCell><mxCell id="c38" value="Cubo = nodo («device» = máquina física; «executionEnvironment» = software que ejecuta otros artefactos). Rectángulo con hoja = artefacto. Línea sólida = camino de comunicación. Punteada «deploy» = el artefacto se instala en ese nodo." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=8;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Helvetica;fontSize=13;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="905" width="1670" height="44" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>