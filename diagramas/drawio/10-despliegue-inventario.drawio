<mxfile host="drawio_lib"><diagram id="d1" name="Despliegue - Inventario"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1740" pageHeight="970" background="#ffffff" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="&lt;b&gt;Diagrama de despliegue — Inventario (Smart Bite)&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:13px' color='#555555'&gt;Dónde corre hoy cada pieza y cómo se conecta con la base de datos en Neon&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=13;fontSize=20;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1660" height="50" as="geometry"/></mxCell><mxCell id="c3" value="«device»&lt;br&gt;&lt;b&gt;PC o tablet del usuario&lt;/b&gt;" style="shape=cube;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;darkOpacity=0.05;darkOpacity2=0.1;size=12;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontFamily=Helvetica;fontSize=13;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="170" width="300" height="190" as="geometry"/></mxCell><mxCell id="c4" value="«executionEnvironment»&lt;br&gt;&lt;b&gt;Navegador web&lt;/b&gt;" style="shape=cube;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;darkOpacity=0.05;darkOpacity2=0.1;size=12;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Helvetica;fontSize=13;fontSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="245" width="250" height="90" as="geometry"/></mxCell><mxCell id="c5" value="«device»&lt;br&gt;&lt;b&gt;Computadora de desarrollo (cada integrante)&lt;/b&gt;" style="shape=cube;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;darkOpacity=0.05;darkOpacity2=0.1;size=12;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontFamily=Helvetica;fontSize=13;fontSize=13;" vertex="1" parent="1"><mxGeometry x="400" y="110" width="720" height="700" as="geometry"/></mxCell><mxCell id="c6" value="«executionEnvironment»&lt;br&gt;&lt;b&gt;Python 3 + Django 5.2 (venv)&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;manage.py runserver → http://127.0.0.1:8000&lt;/font&gt;" style="shape=cube;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;darkOpacity=0.05;darkOpacity2=0.1;size=12;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Helvetica;fontSize=13;fontSize=12;" vertex="1" parent="1"><mxGeometry x="425" y="175" width="420" height="230" as="geometry"/></mxCell><mxCell id="c7" value="«artifact»&lt;br&gt;&lt;b&gt;smartbite&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;código del repo (apps Django)&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;spacingRight=16;fillColor=#ffffff;strokeColor=#333333;fontFamily=Helvetica;fontSize=13;fontSize=12;" vertex="1" parent="1"><mxGeometry x="450" y="290" width="240" height="70" as="geometry"/></mxCell><mxCell id="c8" value="" style="shape=note;size=5;html=1;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="c7"><mxGeometry x="220" y="6" width="12" height="15" as="geometry"/></mxCell><mxCell id="c9" value="«file»&lt;br&gt;&lt;b&gt;db.sqlite3&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;la base de Django hoy;&lt;br&gt;no se sube al repo&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;spacingRight=16;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontFamily=Helvetica;fontSize=13;fontSize=12;" vertex="1" parent="1"><mxGeometry x="880" y="215" width="210" height="84" as="geometry"/></mxCell><mxCell id="c10" value="" style="shape=note;size=5;html=1;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="c9"><mxGeometry x="190" y="6" width="12" height="15" as="geometry"/></mxCell><mxCell id="c11" value="«executi