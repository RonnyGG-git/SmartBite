y=Helvetica;fontSize=13;fontSize=11;" vertex="1" parent="1"><mxGeometry x="450" y="590" width="180" height="80" as="geometry"/></mxCell><mxCell id="c11" value="«script»&lt;br&gt;&lt;b&gt;SMARTBITE_COMPRAS&lt;br&gt;_SP.sql&lt;/b&gt;" style="shape=note;size=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontFamily=Helvetica;fontSize=13;fontSize=11;" vertex="1" parent="1"><mxGeometry x="650" y="590" width="180" height="80" as="geometry"/></mxCell><mxCell id="c12" value="«archivo»&lt;br&gt;&lt;b&gt;.env.test&lt;br&gt;(cadena de conexión;&lt;br&gt;no se sube)&lt;/b&gt;" style="shape=note;size=12;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontFamily=Helvetica;fontSize=13;fontSize=11;" vertex="1" parent="1"><mxGeometry x="850" y="590" width="190" height="80" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;«nube»&lt;br&gt;Neon — PostgreSQL gestionado&lt;/b&gt;" style="shape=cube;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;darkOpacity=0.05;darkOpacity2=0.1;size=14;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontFamily=Helvetica;fontSize=13;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1200" y="110" width="460" height="690" as="geometry"/></mxCell><mxCell id="c14" value="«base de datos»&lt;br&gt;&lt;b&gt;Rama principal (base del equipo)&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;los scripts se aplican cuando pasan&lt;br&gt;las pruebas; Django la usará con la&lt;br&gt;spec 003&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;verticalAlign=top;spacingTop=14;fillColor=#d5e8d4;strokeColor=#82b366;fontFamily=Helvetica;fontSize=13;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1240" y="190" width="380" height="170" as="geometry"/></mxCell><mxCell id="c15" value="«base de datos»&lt;br&gt;&lt;b&gt;Rama de prueba (test-inventario-jose)&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;el esquema se borra y se recrea&lt;br&gt;en cada corrida de los tests&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;verticalAlign=top;spacingTop=14;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Helvetica;fontSize=13;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1240" y="500" width="380" height="160" as="geometry"/></mxCell><mxCell id="c16" value="" style="endArrow=none;html=1;strokeColor=#333333;strokeWidth=1.2;fontFamily=Helvetica;fontSize=13;exitX=1;exitY=0.5;entryX=0;entryY=0.5227;" edge="1" parent="1" source="c4" target="c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c17" value="«HTTP»" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontSize=12;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="340" y="262" width="90" height="18" as="geometry"/></mxCell><mxCell id="c18" value="" style="endArrow=none;html=1;strokeColor=#333333;strokeWidth=1.2;fontFamily=Helvetica;fontSize=13;exitX=1;exitY=0.3682;entryX=0;entryY=0.5;" edge="1" parent="1" source="c6" target="c8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c19" value="" style="endArrow=none;html=1;strokeColor=#333333;strokeWidth=1.2;fontFamily=Helvetica;fontSize=13;exitX=1;exitY=0.44;entryX=0;entryY=0.5;" edge="1" parent="1" source="c9" target="c15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c20" value="«PostgreSQL + TLS»&lt;br&gt;(sslmode=require)" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontSize=11;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="1075" y="530" width="130" height="34" as="geometry"/></mxCell><mxCell id="c21" value="" style="endArrow=none;html=1;strokeColor=#333333;strokeWidth=1.2;fontFamily=Helvetica;fontSize=13;strokeColor=#b85450;fontColor=#b85450;dashed=1;dashPattern=8 4;exitX=0.75;exitY=0;entryX=0;entryY=0.3;" edge="1" parent="1" source="c6" target="c14"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="730" y="100"/><mxPoint x="1160" y="100"/><mxPoint x="1160" y="241"/></Array></mxGeometry></mxCell><mxCell id="c22" value="«PostgreSQL + TLS» (psycopg2) — spec 003" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontSize=11;fontColor=#b85450;" vertex="1" parent="1"><mxGeometry x="780" y="80" width="330" height="18" as="geometry"/></mxCell><mxCell id="c23" value="" style="endArrow=open;endSize=10;dashed=1;html=1;strokeColor=#666666;fontColor=#444444;fontFamily=Helvetica;fontSize=13;fontSize=12;labelBackgroundColor=#ffffff;exitX=1;exitY=0.1;entryX=0;entryY=0.75;" edge="1" parent="1" source="c9" target="c14"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1140" y="495"/><mxPoint x="1140" y="317"/></Array></mxGeometry></mxCell><mxCell id="c24" value="«deploy»: los mismos scripts se aplican a la&lt;br&gt;rama principal cuando pasan las pruebas&lt;br&gt;(principio 7)" style="text;html=1;align=right;verticalAlign=middle;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontSize=11;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="850" y="408" width="280" height="50" as="geometry"/></mxCell><mxCell id="c25" value="Producción: no definida. Dónde se aloja Django y cómo se respalda la base es una decisión pendiente del equipo (ADR, principio 9 de la constitución); por eso no se dibuja un servidor de producción." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=8;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Helvetica;fontSize=13;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="840" width="800" height="50" as="geometry"/></mxCell><mxCell id="c26" value="El código se comparte por GitHub (RonnyGG-git/SmartBite) y cada integrante lo corre en su computadora: en desarrollo, el navegador y el servidor suelen ser la misma máquina." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=8;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Helvetica;fontSize=13;fontSize=11;" vertex="1" parent="1"><mxGeometry x="860" y="840" width="800" height="50" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>