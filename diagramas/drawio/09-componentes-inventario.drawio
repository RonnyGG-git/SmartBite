ght="2" as="geometry"/></mxCell><mxCell id="c57" value="«use»" style="endArrow=open;endSize=10;dashed=1;html=1;strokeColor=#555555;fontColor=#333333;fontFamily=Helvetica;fontSize=13;fontSize=12;labelBackgroundColor=#ffffff;strokeColor=#b85450;fontColor=#b85450;dashPattern=8 4;exitX=1;exitY=0.2;entryX=0;entryY=0.5;" edge="1" parent="1" source="c24" target="c56"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c58" value="" style="rounded=0;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="1293" y="544" width="2" height="2" as="geometry"/></mxCell><mxCell id="c59" value="«use»" style="endArrow=open;endSize=10;dashed=1;html=1;strokeColor=#555555;fontColor=#333333;fontFamily=Helvetica;fontSize=13;fontSize=12;labelBackgroundColor=#ffffff;strokeColor=#b85450;fontColor=#b85450;dashPattern=8 4;exitX=1;exitY=0.85;entryX=0;entryY=0.5;" edge="1" parent="1" source="c24" target="c58"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c60" value="" style="rounded=0;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="1293" y="719" width="2" height="2" as="geometry"/></mxCell><mxCell id="c61" value="«use»" style="endArrow=open;endSize=10;dashed=1;html=1;strokeColor=#555555;fontColor=#333333;fontFamily=Helvetica;fontSize=13;fontSize=12;labelBackgroundColor=#ffffff;strokeColor=#b85450;fontColor=#b85450;dashPattern=8 4;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c28" target="c60"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c62" value="En rojo: conexiones de la spec 003. Hoy Django usa SQLite con sus propios modelos y cambia el stock en Python; con la spec 003 pasa a Neon y usa estas interfaces." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=8;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Helvetica;fontSize=13;fontSize=11;" vertex="1" parent="1"><mxGeometry x="330" y="800" width="330" height="80" as="geometry"/></mxCell><mxCell id="c63" value="fn_generar_perdidas_vencimiento() la tiene que ejecutar la aplicación una vez por día (RF-26); todavía nadie la llama." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=8;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Helvetica;fontSize=13;fontSize=11;" vertex="1" parent="1"><mxGeometry x="680" y="800" width="320" height="80" as="geometry"/></mxCell><mxCell id="c64" value="Bola (círculo) = interfaz que el componente ofrece. Socket (medio círculo) = interfaz que el componente necesita. Flecha punteada = dependencia: el de la cola usa al de la punta." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=8;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Helvetica;fontSize=13;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="960" width="980" height="44" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>