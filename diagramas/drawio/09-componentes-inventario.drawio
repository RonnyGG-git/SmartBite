width="14" height="18" as="geometry"/></mxCell><mxCell id="c52" value="" style="endArrow=none;html=1;strokeColor=#333333;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1310" y="740.0" as="sourcePoint"/><mxPoint x="1280" y="740.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c53" value="" style="ellipse;html=1;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="1264" y="732.0" width="16" height="16" as="geometry"/></mxCell><mxCell id="c54" value="DB-API 2.0" style="text;html=1;align=right;verticalAlign=middle;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontSize=11;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="1207" y="712.0" width="69" height="14" as="geometry"/></mxCell><mxCell id="c55" value="" style="endArrow=none;html=1;strokeColor=#333333;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1207" y="740.0" as="sourcePoint"/><mxPoint x="1261" y="740.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c56" value="" style="shape=requiredInterface;html=1;direction=west;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="1261" y="729.0" width="11" height="22" as="geometry"/></mxCell><mxCell id="c57" value="«component»&lt;br&gt;&lt;b&gt;Esquema de la base&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;Tablas que crean las migraciones de Django&lt;br&gt;(inventario/migrations):&lt;br&gt;&lt;br&gt;inventario_proveedor&lt;br&gt;inventario_iteminventario&lt;br&gt;inventario_movimientoinventario&lt;br&gt;inventario_compra&lt;br&gt;inventario_detallecompra&lt;br&gt;+ las tablas de las otras apps&lt;br&gt;&lt;br&gt;Sin triggers ni funciones: las reglas (sumar o&lt;br&gt;restar stock, estados de la compra) están en&lt;br&gt;las vistas de Django.&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;spacingTop=6;spacingLeft=6;spacingRight=22;fillColor=#e1d5e7;strokeColor=#9673a6;fontFamily=Helvetica;fontSize=13;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1290" y="180" width="430" height="330" as="geometry"/></mxCell><mxCell id="c58" value="" style="shape=module;jettyWidth=6;jettyHeight=3;html=1;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="c57"><mxGeometry x="406" y="8" width="14" height="18" as="geometry"/></mxCell><mxCell id="c59" value="" style="endArrow=open;endSize=10;dashed=1;html=1;strokeColor=#555555;fontColor=#333333;fontFamily=Helvetica;fontSize=13;fontSize=12;labelBackgroundColor=#ffffff;exitX=0.45;exitY=0;entryX=0.5;entryY=1;" edge="1" parent="1" source="c50" target="c57"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c60" value="«use»&lt;br&gt;SQL" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontSize=11;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="1412.5" y="560" width="60" height="32" as="geometry"/></mxCell><mxCell id="c61" value="Bola (círculo) = interfaz que el componente ofrece. Socket (medio círculo) = interfaz que necesita; cuando abraza una bola, las dos piezas están conectadas. Punteada = dependencia (el de la cola usa al de la punta). Cuadrado en el borde = puerto; la línea con flecha que entra o sale de él lleva el pedido a la pieza interna (delegación)." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=8;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Helvetica;fontSize=13;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="890" width="860" height="76" as="geometry"/></mxCell><mxCell id="c62" value="Hoy la única interfaz hacia afuera son páginas HTML por HTTP: todavía no hay API REST. Compras vive dentro de la misma app (las vistas compra_* usan los mismos modelos). Dónde corre cada pieza (PC, Neon): diagrama de despliegue." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=8;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Helvetica;fontSize=13;fontSize=11;" vertex="1" parent="1"><mxGeometry x="920" y="890" width="800" height="76" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>