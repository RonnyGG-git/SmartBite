ily=Helvetica;fontSize=13;fontSize=12;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="1073" y="475" width="274" height="51" as="geometry"/></mxCell><mxCell id="c43" value="" style="html=1;endArrow=block;endFill=1;endSize=7;strokeColor=#333333;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1272" y="763" as="sourcePoint"/><mxPoint x="1306" y="733" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c44" value="2.1.1.1: SELECT stock_actual FOR UPDATE,&lt;br&gt;2.1.1.2: UPDATE stock_actual&lt;br&gt;= cantidad_objetivo" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontSize=12;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="1073" y="634" width="274" height="51" as="geometry"/></mxCell><mxCell id="c45" value="" style="html=1;endArrow=block;endFill=1;endSize=7;strokeColor=#333333;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1554" y="412" as="sourcePoint"/><mxPoint x="1596" y="431" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c46" value="1.1.1.4 [diferencia ≤ umbral]:&lt;br&gt;fn_generar_solicitud_si_hace_falta(&lt;br&gt;item_inventario_id, cantidad_objetivo)" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontSize=12;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="1481" y="318" width="260" height="51" as="geometry"/></mxCell><mxCell id="c47" value="" style="html=1;endArrow=block;endFill=1;endSize=7;strokeColor=#333333;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1554" y="748" as="sourcePoint"/><mxPoint x="1596" y="729" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c48" value="2.1.1.4: fn_generar_solicitud_si_hace_falta(&lt;br&gt;item_inventario_id, cantidad_objetivo)" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontSize=12;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="1461" y="800" width="300" height="36" as="geometry"/></mxCell><mxCell id="c49" value="" style="html=1;endArrow=block;endFill=1;endSize=7;strokeColor=#333333;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1896" y="737" as="sourcePoint"/><mxPoint x="1896" y="783" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c50" value="1.1.1.4.1 [cantidad_objetivo&lt;br&gt;&amp;lt; stock_minimo]: INSERT PENDIENTE,&lt;br&gt;2.1.1.4.1 [cantidad_objetivo&lt;br&gt;&amp;lt; stock_minimo]: INSERT PENDIENTE" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontSize=12;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="1904" y="727" width="234" height="66" as="geometry"/></mxCell><mxCell id="c51" value="umbral = app.umbral_ajuste_aprobacion; si no se configura, 20 unidades (valor de negocio a confirmar con el Administrador)." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=8;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Helvetica;fontSize=13;fontSize=12;" vertex="1" parent="1"><mxGeometry x="30" y="1120" width="560" height="50" as="geometry"/></mxCell><mxCell id="c52" value="Un ajuste se aprueba una sola vez. El esquema no tiene rechazo: un ajuste que no se aprueba queda pendiente y no cambia el stock." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=8;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Helvetica;fontSize=13;fontSize=12;" vertex="1" parent="1"><mxGeometry x="620" y="1120" width="560" height="50" as="geometry"/></mxCell><mxCell id="c53" value="«vista» = vista de Django que llega con la spec 003 (hoy Django solo registra ENTRADA y SALIDA). Numeración decimal: 1.1.1 ocurre dentro de 1.1; [ ] = guarda; dos mensajes en un mismo enlace van separados por coma." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=8;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Helvetica;fontSize=13;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1210" y="1120" width="1000" height="50" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>