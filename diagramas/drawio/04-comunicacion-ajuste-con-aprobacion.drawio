as="geometry"><mxPoint x="1596" y="630" as="sourcePoint"/><mxPoint x="1596" y="676" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c43" value="1.1.1.4.1 / 2.1.1.4.1&lt;br&gt;[objetivo &amp;lt; stock_minimo]:&lt;br&gt;INSERT PENDIENTE" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontSize=12;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="1604" y="627" width="181" height="51" as="geometry"/></mxCell><mxCell id="c44" value="" style="html=1;endArrow=open;endSize=10;strokeColor=#333333;fontFamily=Helvetica;fontSize=13;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="880" y="178.0" as="sourcePoint"/><mxPoint x="980" y="178.0" as="targetPoint"/><Array as="points"><mxPoint x="880" y="144.0"/><mxPoint x="980" y="144.0"/></Array></mxGeometry></mxCell><mxCell id="c45" value="1.1.1.3 [diferencia &amp;gt; umbral]: requiere_aprobacion = true, stock_nuevo = NULL (el stock no cambia)" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontSize=12;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="600" y="116.0" width="660" height="20" as="geometry"/></mxCell><mxCell id="c46" value="" style="html=1;endArrow=open;endSize=10;strokeColor=#333333;fontFamily=Helvetica;fontSize=13;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="880" y="832.0" as="sourcePoint"/><mxPoint x="980" y="832.0" as="targetPoint"/><Array as="points"><mxPoint x="880" y="866.0"/><mxPoint x="980" y="866.0"/></Array></mxGeometry></mxCell><mxCell id="c47" value="2.1.1.3: stock_anterior, stock_nuevo = cantidad_objetivo, aprobado_en = now()" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontSize=12;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="630" y="872.0" width="600" height="20" as="geometry"/></mxCell><mxCell id="c48" value="umbral = app.umbral_ajuste_aprobacion; si no se configura, 20 unidades (valor de negocio a confirmar con el Administrador)." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=8;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Helvetica;fontSize=13;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="960" width="540" height="46" as="geometry"/></mxCell><mxCell id="c49" value="Un ajuste se aprueba una sola vez. El esquema no tiene rechazo: un ajuste que no se aprueba queda pendiente y no cambia el stock." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=8;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Helvetica;fontSize=13;fontSize=12;" vertex="1" parent="1"><mxGeometry x="620" y="960" width="540" height="46" as="geometry"/></mxCell><mxCell id="c50" value="Hoy Django solo registra ENTRADA y SALIDA: la vista de ajuste y la de aprobación llegan con la spec 003." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=8;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Helvetica;fontSize=13;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1200" y="960" width="540" height="46" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>