<mxfile host="drawio_lib"><diagram id="d1" name="Comunicación - Ajuste con aprobación"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2240" pageHeight="1200" background="#ffffff" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="&lt;b&gt;Diagrama de comunicación — Realizar ajuste de inventario con aprobación (CU-INV-08)&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:13px' color='#555555'&gt;Un AJUSTE fija el stock en una cantidad objetivo con motivo (RF-15, RF-16); si la diferencia supera el umbral, no toca el stock hasta que lo aprueba el Administrador (RF-17)&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=13;fontSize=20;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="2160" height="50" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;sd Realizar ajuste de inventario con aprobación&lt;/b&gt;" style="shape=umlFrame;whiteSpace=wrap;html=1;pointerEvents=0;width=371;height=26;fillColor=none;strokeColor=#666666;align=left;spacingLeft=6;fontFamily=Helvetica;fontSize=13;fontSize=12;" vertex="1" parent="1"><mxGeometry x="30" y="96" width="2180" height="1000" as="geometry"/></mxCell><mxCell id="c4" value="«vista»&lt;br&gt;:VistaAjuste" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Helvetica;fontSize=13;fontSize=12;" vertex="1" parent="1"><mxGeometry x="280.0" y="190.0" width="200" height="60" as="geometry"/></mxCell><mxCell id="c5" value="«vista»&lt;br&gt;:VistaAprobacion" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Helvetica;fontSize=13;fontSize=12;" vertex="1" parent="1"><mxGeometry x="280.0" y="910.0" width="200" height="60" as="geometry"/></mxCell><mxCell id="c6" value="«table»&lt;br&gt;:movimiento_inventario" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;f