on)&lt;/b&gt;" style="swimlane;html=1;startSize=30;horizontal=1;fillColor=#f5f5f5;strokeColor=#999999;swimlaneFillColor=none;fontFamily=Helvetica;fontSize=13;fontSize=13;" vertex="1" parent="1"><mxGeometry x="700" y="140" width="810" height="1690" as="geometry"/></mxCell><mxCell id="c7" value="" style="ellipse;html=1;fillColor=#333333;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="202" y="200" width="26" height="26" as="geometry"/></mxCell><mxCell id="c8" value="Elegir el insumo y el&lt;br&gt;tipo de movimiento" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Helvetica;fontSize=13;fontSize=12;" vertex="1" parent="1"><mxGeometry x="125.0" y="247.0" width="180" height="56" as="geometry"/></mxCell><mxCell id="c9" value="" style="rhombus;html=1;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="198" y="343" width="34" height="34" as="geometry"/></mxCell><mxCell id="c10" value="Indicar cantidad y motivo&lt;br&gt;(en una pérdida, la causa)" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Helvetica;fontSize=13;fontSize=12;" vertex="1" parent="1"><mxGeometry x="55.0" y="416.0" width="160" height="58" as="geometry"/></mxCell><mxCell id="c11" value="Indicar cantidad&lt;br&gt;objetivo y motivo" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Helvetica;fontSize=13;fontSize=12;" vertex="1" parent="1"><mxGeometry x="230.0" y="416.0" width="140" height="58" as="geometry"/></mxCell><mxCell id="c12" value="" style="rhombus;html=1;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="198" y="523" width="34" height="34" as="geometry"/></mxCell><mxCell id="c13" value="Corregir los datos" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Helvetica;fontSize=13;fontSize=12;" vertex="1" parent="1"><mxGeometry x="135.0" y="615.0