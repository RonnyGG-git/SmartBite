<mxfile host="drawio_lib"><diagram id="d1" name="Clases - Inventario"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1660" pageHeight="934" background="#ffffff" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="&lt;b&gt;Diagrama de clases — Inventario (Smart Bite)&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:13px' color='#555555'&gt;Los modelos de Django de la app inventario (rama smartbite) y las clases de otras apps con las que se relacionan&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=13;fontSize=20;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1580" height="50" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;core::TimestampedModel&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;{abstract}&lt;/font&gt;" style="swimlane;fontStyle=0;html=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=40;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontFamily=Helvetica;fontSize=13;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="650" y="100" width="360" height="80" as="geometry"/></mxCell><mxCell id="c4" value="+ creado_en: DateTimeField {auto_now_add}&lt;br&gt;+ actualizado_en: DateTimeField {auto_now}" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;overflow=hidden;rotatable=0;fontFamily=Helvetica;fontSize=13;fontSize=12;whiteSpace=wrap;" vertex="1" parent="c3"><mxGeometry x="0" y="40" width="360" height="40" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;Proveedor&lt;/b&gt;" style="swimlane;fontStyle=0;html=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=26;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsibl