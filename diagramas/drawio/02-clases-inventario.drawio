sp;&amp;nbsp;&amp;nbsp;&amp;nbsp;{PENDIENTE, RECIBIDA o ANULADA}&lt;br&gt;+ /total: Decimal {Σ subtotal de los detalles}" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;overflow=hidden;rotatable=0;fontFamily=Helvetica;fontSize=13;fontSize=12;whiteSpace=wrap;" vertex="1" parent="c9"><mxGeometry x="0" y="26" width="290" height="70" as="geometry"/></mxCell><mxCell id="c11" value="" style="line;strokeWidth=1;fillColor=none;align=left;verticalAlign=middle;spacingTop=-1;spacingLeft=3;spacingRight=3;rotatable=0;labelPosition=right;points=[];portConstraint=eastwest;strokeColor=inherit;" vertex="1" parent="c9"><mxGeometry x="0" y="96" width="290" height="1" as="geometry"/></mxCell><mxCell id="c12" value="+ __str__(): str" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;overflow=hidden;rotatable=0;fontFamily=Helvetica;fontSize=13;fontSize=12;whiteSpace=wrap;" vertex="1" parent="c9"><mxGeometry x="0" y="97" width="290" height="25" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;ItemInventario&lt;/b&gt;" style="swimlane;fontStyle=0;html=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=26;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Helvetica;fontSize=13;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="780" y="300" width="360" height="212" as="geometry"/></mxCell><mxCell id="c14" value="+ id: BigAutoField {id}&lt;br&gt;+ nombre: CharField(150)&lt;br&gt;+ descripcion: CharField(255)&lt;br&gt;+ unidad_medida: CharField(20) = unidad&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;{kg, g, L, ml, unidad, caja o paquete}&lt;br&gt;+ stock_actual: PositiveIntegerField = 0&lt;br&gt;+ stock_minimo: PositiveIntegerField = 0&lt;br&gt;+ costo_unitario: DecimalField(10,2) = 0&lt;br&gt;+ ubicacion: CharField(150