ado: INTEGER" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;overflow=hidden;rotatable=0;fontFamily=Helvetica;fontSize=13;fontSize=12;whiteSpace=wrap;" vertex="1" parent="c60"><mxGeometry x="0" y="54" width="420" height="100" as="geometry"/></mxCell><mxCell id="c62" value="" style="endArrow=open;endSize=10;dashed=1;html=1;strokeColor=#555555;fontColor=#333333;fontFamily=Helvetica;fontSize=13;fontSize=12;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0;entryX=0.8583;entryY=1;edgeStyle=orthogonalEdgeStyle;rounded=0;" edge="1" parent="1" source="c56" target="c8"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="320" y="1059"/><mxPoint x="625" y="1059"/></Array></mxGeometry></mxCell><mxCell id="c63" value="" style="endArrow=open;endSize=10;dashed=1;html=1;strokeColor=#555555;fontColor=#333333;fontFamily=Helvetica;fontSize=13;fontSize=12;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0;entryX=0.8583;entryY=1;edgeStyle=orthogonalEdgeStyle;rounded=0;" edge="1" parent="1" source="c58" target="c8"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="790" y="1059"/><mxPoint x="625" y="1059"/></Array></mxGeometry></mxCell><mxCell id="c64" value="" style="endArrow=open;endSize=10;dashed=1;html=1;strokeColor=#555555;fontColor=#333333;fontFamily=Helvetica;fontSize=13;fontSize=12;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0;entryX=0.8583;entryY=1;edgeStyle=orthogonalEdgeStyle;rounded=0;" edge="1" parent="1" source="c60" target="c8"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1260" y="1059"/><mxPoint x="625" y="1059"/></Array></mxGeometry></mxCell><mxCell id="c65" value="" style="ellipse;html=1;fillColor=#555555;strokeColor=#555555;" vertex="1" parent="1"><mxGeometry x="621" y="1055" width="8" height="8" as="geometry"/></mxCell><mxCell id="c66" value="«derive»" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontSize=12;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="631" y="999" width="70" height="18" as="geometry"/></mxCell><mxCell id="c67" value="" style="endArrow=open;endSize=10;dashed=1;html=1;strokeColor=#555555;fontColor=#333333;fontFamily=Helvetica;fontSize=13;fontSize=12;labelBackgroundColor=#ffffff;exitX=0;exitY=0.25;entryX=0;entryY=0.3279;edgeStyle=orthogonalEdgeStyle;rounded=0;" edge="1" parent="1" source="c56" target="c3"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="45" y="1169"/><mxPoint x="45" y="140"/></Array></mxGeometry></mxCell><mxCell id="c68" value="«derive»" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontSize=12;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="49" y="619" width="60" height="18" as="geometry"/></mxCell><mxCell id="c69" value="Modelo de datos físico (perfil de datos de Ambler): cada clase sin estereotipo es una tabla; atributos = columnas con su tipo SQL; operaciones = triggers y funciones.&lt;br&gt;Visibilidad: + columna o función que se puede usar desde fuera (otro módulo, la app); - trigger: lo dispara la base, no se puede llamar; ~ función de uso interno del paquete Inventario (la llaman los triggers de MovimientoInventario). # no aparece: no hay herencia entre tablas.&lt;br&gt;Subrayado = estático (no depende de una fila). [0..1] = admite NULL (sin multiplicidad se entiende 1). {…} = restricción. Las columnas FK no se listan: son las asociaciones.&lt;br&gt;Las clases grises son de otros módulos (Modulo::Clase); {sin FK física todavía} = la columna existe pero la tabla destino todavía no está en Neon. Fuente: sql/TABLAS/SMARTBITE_INVENTARIO_SP.sql (spec 001)." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=8;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Helvetica;fontSize=13;fontSize=12;" vertex="1" parent="1"><mxGeometry x="110" y="1368" width="1790" height="96" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>