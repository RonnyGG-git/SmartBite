<mxfile host="drawio_lib"><diagram id="d1" name="Clases - Inventario"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1960" pageHeight="1498" background="#ffffff" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="&lt;b&gt;Diagrama de clases — Inventario (Smart Bite)&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:13px' color='#555555'&gt;Modelo de datos en PostgreSQL (Neon): 5 tablas con sus triggers y funciones, 3 vistas y las clases de otros módulos a las que apuntan&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=13;fontSize=20;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1880" height="50" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;CategoriaInsumo&lt;/b&gt;" style="swimlane;fontStyle=0;html=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=26;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Helvetica;fontSize=13;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="110" y="100" width="330" height="122" as="geometry"/></mxCell><mxCell id="c4" value="+ id: BIGINT {id}&lt;br&gt;+ nombre: VARCHAR(100) {único}&lt;br&gt;+ creado_en: TIMESTAMPTZ&lt;br&gt;+ actualizado_en: TIMESTAMPTZ" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;overflow=hidden;rotatable=0;fontFamily=Helvetica;fontSize=13;fontSize=12;whiteSpace=wrap;" vertex="1" parent="c3"><mxGeometry x="0" y="26" width="330" height="70" as="geometry"/></mxCell><mxCell id="c5" value="" style="line;strokeWidth=1;fillColor=none;align=left;verticalAlign=middle;spacingTop=-1;spacingLeft=3;spacingRight=3;rotatable=0;labelPosition=right;points=[];portConstraint=eastwest;strokeColor=inherit;" vertex="1" parent="c3"><mxGeometry x="0" y="96"