ertex="1" parent="c8"><mxGeometry x="0" y="26" width="600" height="205" as="geometry"/></mxCell><mxCell id="c10" value="" style="line;strokeWidth=1;fillColor=none;align=left;verticalAlign=middle;spacingTop=-1;spacingLeft=3;spacingRight=3;rotatable=0;labelPosition=right;points=[];portConstraint=eastwest;strokeColor=inherit;" vertex="1" parent="c8"><mxGeometry x="0" y="231" width="600" height="1" as="geometry"/></mxCell><mxCell id="c11" value="- «trigger» fn_item_inventario_generar_codigo(): trigger&lt;br&gt;- «trigger» fn_item_inventario_codigo_inmutable(): trigger&lt;br&gt;- «trigger» fn_item_inventario_proteger_stock(): trigger&lt;br&gt;- «trigger» fn_item_inventario_validar_desactivacion(): trigger&lt;br&gt;- «trigger» fn_item_inventario_registrar_historial(): trigger&lt;br&gt;- «trigger» fn_marcar_actualizado_en(): trigger&lt;br&gt;&lt;u&gt;+ fn_verificar_disponibilidad(items: JSONB): TABLE(item_inventario_id,&lt;/u&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;u&gt;cantidad_requerida, disponible) {query}&lt;/u&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;overflow=hidden;rotatable=0;fontFamily=Helvetica;fontSize=13;fontSize=12;whiteSpace=wrap;" vertex="1" parent="c8"><mxGeometry x="0" y="232" width="600" height="130" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;MovimientoInventario&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;{kardex: solo se agregan filas; un AJUSTE pendiente se aprueba una vez}&lt;/font&gt;" style="swimlane;fontStyle=0;html=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=40;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Helvetica;fontSize=13;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="830" y="320" width="640" height="316" as="geometry"/></mxCell><mxCell id="c13" value="+ id: BIGINT {id}&lt;