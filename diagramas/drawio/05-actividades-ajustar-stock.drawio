<mxfile host="drawio_lib"><diagram id="d1" name="Actividades - Ajustar stock"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1340" pageHeight="1345" background="#ffffff" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="&lt;b&gt;Diagrama de actividades — Ajustar el stock de un ítem (entrada o salida)&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:13px' color='#555555'&gt;Cómo lo hace la vista item_ajustar_stock de la app Django (rama smartbite)&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=13;fontSize=20;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1260" height="50" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;act Ajustar el stock de un ítem&lt;/b&gt;" style="shape=umlFrame;whiteSpace=wrap;html=1;pointerEvents=0;width=253;height=26;fillColor=none;strokeColor=#666666;align=left;spacingLeft=6;fontFamily=Helvetica;fontSize=13;fontSize=12;" vertex="1" parent="1"><mxGeometry x="30" y="90" width="1290" height="1240" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;Jefe de Inventario&lt;/b&gt;" style="swimlane;html=1;startSize=30;horizontal=1;fillColor=#f5f5f5;strokeColor=#999999;swimlaneFillColor=none;fontFamily=Helvetica;fontSize=13;fontSize=13;" vertex="1" parent="1"><mxGeometry x="50" y="126" width="470" height="1180" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;App Django (vista item_ajustar_stock)&lt;/b&gt;" style="swimlane;html=1;startSize=30;horizontal=1;fillColor=#f5f5f5;strokeColor=#999999;swimlaneFillColor=none;fontFamily=Helvetica;fontSize=13;fontSize=13;" vertex="1" parent="1"><mxGeometry x="520" y="126" width="780" height="1180" as="geometry"/></mxCell><mxCell id="c6" value="" style="ellipse;html=1;fillColor=#333333;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="272" y="190" width="26" height="26" as="geometry"/></mxCell><mxC